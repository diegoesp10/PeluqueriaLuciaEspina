@model PeluqueriaLuciaEspina.Models.ServicioCliente
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Cobrar Servicio";
    var opcionesPago = Enum.GetValues(typeof(OpcionPago)).Cast<OpcionPago>();
    var total = Model.ServiciosRealizados.Sum(s => s.ServicioGenerico.Precio);
}
@if (TempData["Error"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055">
        <div class="toast align-items-center text-white bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            @if (ViewBag.ErrorCobrando != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorCobrando
                </div>
            }

            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="fas fa-euro-sign me-2"></i> Cobrar Servicio</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-light">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <div class="card-body">
                    <form asp-action="CobrarConfirmado" asp-controller="ServicioCliente" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Cliente</label>
                            <div class="form-control bg-light">@Model.Cliente.Nombre @Model.Cliente.Apellido</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Servicios realizados</label>
                            <ul class="list-group">
                                @foreach (var s in Model.ServiciosRealizados)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>@s.ServicioGenerico.Nombre</span>
                                        <span>@s.ServicioGenerico.Precio.ToString("F2") €</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Total a cobrar</label>
                            <div class="form-control bg-light">@total.ToString("F2") €</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Forma de pago</label>
                            <div class="form-control-plaintext">
                                @Model.OpcionPago.ToString()
                            </div>
                            <input type="hidden" id="formaPago" value="@((int)Model.OpcionPago)" />

                        </div>

                        <div class="mb-3 d-none" id="grupoMixto">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label for="montoEfectivo" class="form-label fw-bolder">Monto en efectivo</label>
                                    <input type="number" min="0" step="0.01" name="montoEfectivo" id="montoEfectivo"
                                           class="form-control" placeholder="Efectivo (€)">
                                </div>
                                <div class="col-md-6">
                                    <label for="montoTarjeta" class="form-label fw-bolder">Monto con tarjeta</label>
                                    <input type="number" min="0" step="0.01" name="montoTarjeta" id="montoTarjeta"
                                           class="form-control" placeholder="Tarjeta (€)">
                                </div>
                            </div>
                            <div class="form-text text-danger d-none" id="errorMixto" aria-live="polite"></div>
                        </div>


                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check-circle me-1"></i> Confirmar cobro
                            </button>
                        </div>
                        <input type="hidden" name="totalEfectivo" id="inputTotalEfectivo" value="0" />
                        <input type="hidden" name="totalTarjeta" id="inputTotalTarjeta" value="0" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const formaPagoInput = document.getElementById('formaPago');
            const grupoMixto = document.getElementById('grupoMixto');
            const errorMixto = document.getElementById('errorMixto');
            const montoEfectivo = document.getElementById('montoEfectivo');
            const montoTarjeta = document.getElementById('montoTarjeta');
            const total = @total.ToString("F2").Replace(',', '.');

            function toggleMixto() {
                if (formaPagoInput.value === '3') {
                    grupoMixto.classList.remove('d-none');
                    montoEfectivo.required = true;
                    montoTarjeta.required = true;
                } else {
                    grupoMixto.classList.add('d-none');
                    errorMixto.classList.add('d-none');
                    montoEfectivo.value = '';
                    montoTarjeta.value = '';
                    montoEfectivo.required = false;
                    montoTarjeta.required = false;
                }
            }

            toggleMixto(); // Ejecutar al cargar

           


            document.querySelector('form').addEventListener('submit', function (e) {
                if (formaPagoInput.value === '3') {
                    const efectivo = parseFloat(montoEfectivo.value) || 0;
                    const tarjeta = parseFloat(montoTarjeta.value) || 0;
                    const suma = (efectivo + tarjeta).toFixed(2);

                    if (parseFloat(suma) !== parseFloat(total)) {
                        e.preventDefault();
                        errorMixto.classList.remove('d-none');
                        errorMixto.innerText = `La suma de efectivo y tarjeta debe ser igual al total de ${total} €`;
                    } else {
                        document.getElementById('inputTotalEfectivo').value = efectivo.toFixed(2).replace('.', ',');
                        document.getElementById('inputTotalTarjeta').value = tarjeta.toFixed(2).replace('.', ',');
                    }
                }
            });
        });

        
    </script>
}
