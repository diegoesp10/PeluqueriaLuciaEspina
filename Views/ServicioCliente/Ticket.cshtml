@model PeluqueriaLuciaEspina.Models.ServicioCliente
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Ticket";
    var fechaCorta = Model.Fecha.ToString("dd/MM/yy");
    var servicios = Model.ServiciosRealizados.ToList();
    var total = servicios.Sum(s => s.PrecioAplicado);
    var metodoPago = Model.OpcionPago switch {
        OpcionPago.Efectivo => "Contado (Efectivo)",
        OpcionPago.Tarjeta  => "Contado (Tarjeta)",
        OpcionPago.Mixto    => "Contado (Mixto)",
        _                   => "Contado"
    };
    // El precio de cada servicio se considera IVA incluido; se desglosa base/cuota
    // según el porcentaje de IVA elegido al cobrar (0% o 21%).
    var baseImponible = Model.PorcentajeIva > 0 ? total / (1 + Model.PorcentajeIva / 100m) : total;
    var cuotaIva = total - baseImponible;
}

<div class="ticket-page-wrapper mt-3">

    <div id="ticket-servicio" class="ticket-receipt">

        <div class="text-center">
            <img src="~/Img/Icono_bn.png" alt="Logo" class="logo-ticket mb-1" />
        </div>
        <div class="text-center fw-bold" style="font-size:15px;">Lucia Peluqueria Ecologica</div>
        <div class="text-center">Oviedo</div>
        <div class="text-center">Tlf 659306659</div>
        <div class="text-center">C/Pio XII, 10</div>

        <div class="ticket-sep"></div>

        <div class="ticket-meta-row">
            <span>Fact. Simpli:@Model.Id</span>
            <span>@fechaCorta</span>
        </div>
        <div>Empleado: lucia espina</div>
        @if (Model.Cliente != null)
        {
            <div>Cliente: @Model.Cliente.Nombre @Model.Cliente.Apellido</div>
        }
        <div style="font-size:11px;color:#666;">NIF: 71678769M</div>

        <div class="ticket-sep"></div>

        <table class="ticket-table">
            <thead>
                <tr>
                    <th class="tc-uds">Uds</th>
                    <th class="tc-name">Descripcion</th>
                    <th class="tc-price">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in servicios)
                {
                    <tr>
                        <td class="tc-uds">1</td>
                        <td class="tc-name">@(s.ServicioGenerico?.Nombre ?? "Servicio")</td>
                        <td class="tc-price">@s.PrecioAplicado.ToString("F2").Replace(".", ",")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="ticket-total-row">
                    <td class="tc-uds"></td>
                    <td class="tc-name text-end fw-bold">TOTAL</td>
                    <td class="tc-price fw-bold">@total.ToString("F2").Replace(".", ",")</td>
                </tr>
            </tfoot>
        </table>

        <div class="ticket-sep"></div>

        <table class="ticket-table">
            <thead>
                <tr>
                    <th>Tipo Imp</th>
                    <th class="text-end">Base</th>
                    <th class="text-end">Cuota</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.PorcentajeIva.ToString("F0")%</td>
                    <td class="text-end">@baseImponible.ToString("F2").Replace(".", ",")</td>
                    <td class="text-end">@cuotaIva.ToString("F2").Replace(".", ",")</td>
                </tr>
            </tbody>
        </table>

        <div class="ticket-sep"></div>

        <div class="text-center fw-bold">
            @(Model.Estado == Estado.Cobrado ? metodoPago : "PENDIENTE DE COBRO")
        </div>
        <div class="text-center">Impuestos Incluidos</div>
        <div class="text-center">Gracias por su visita **</div>
    </div>

    <div class="ticket-side-panel no-print mt-3 d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
        <form id="form-imprimir-ticket" asp-action="ImprimirTicket" asp-controller="ServicioCliente" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Id" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-dark btn-sm" id="btn-imprimir-ticket">
                <i class="fas fa-print me-1"></i>Imprimir
            </button>
        </form>
    </div>

    <div id="ticket-print-toast" class="position-fixed top-0 end-0 p-3 no-print" style="z-index: 1055"></div>

</div>

@section Scripts {
    <script>
        document.getElementById('form-imprimir-ticket').addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = this;
            const btn = document.getElementById('btn-imprimir-ticket');
            const toastContainer = document.getElementById('ticket-print-toast');
            const original = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Imprimiendo...';

            function mostrarToast(bg, mensaje) {
                toastContainer.innerHTML = `
                    <div class="toast align-items-center text-white ${bg} border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">${mensaje}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                        </div>
                    </div>`;
            }

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                });
                const data = await response.json();

                mostrarToast(
                    data.ok ? 'bg-success' : 'bg-danger',
                    data.ok
                        ? '<i class="fas fa-check-circle me-2"></i>Ticket enviado a la impresora.'
                        : `<i class="fas fa-exclamation-triangle me-2"></i>${data.error || 'No se pudo imprimir el ticket.'}`
                );
            } catch (err) {
                mostrarToast('bg-danger', '<i class="fas fa-exclamation-triangle me-2"></i>Error de conexión al imprimir el ticket.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        });
    </script>
}
