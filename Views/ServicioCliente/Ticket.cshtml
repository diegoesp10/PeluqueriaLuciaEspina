@model PeluqueriaLuciaEspina.Models.ServicioCliente
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Ticket del Servicio";
    var fechaFormateada = Model.Fecha.ToString("dd/MM/yyyy");
    var total = Model.ServiciosRealizados.Sum(s => s.ServicioGenerico.Precio);
}

<div class="container mt-4">
    <div id="ticket-servicio" class="card shadow-sm border-0 p-4">
        <div class="ticket-header text-center mb-4">
            <img src="~/Img/Icono_bn.png" alt="Logo Peluquería B/N" class="logo-ticket mb-2" />
            <h5 class="fw-bold mb-1">Peluquería Ecológica Lucía Espina</h5>
            <p class="mb-0 small">NIF: 71678769M</p>
            <p class="mb-0 small">Calle Pío XII, 10 Bajo 1 - Oviedo, Asturias</p>
        </div>

        <hr>

        <div class="mb-3">
            <strong>Nº Ticket:</strong> @Model.Id<br />
            <strong>Fecha:</strong> @fechaFormateada<br />
            <strong>Cliente:</strong> @Model.Cliente!.Nombre @Model.Cliente.Apellido
        </div>

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Descripción</th>
                    <th class="text-end">Precio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.ServiciosRealizados.Where(s => s.ServicioGenerico != null))
                {
                    <tr>
                        @if(s.ServicioGenerico!= null)
                        {
                            <td>@s.ServicioGenerico.Nombre</td>
                            <td class="text-end">@s.ServicioGenerico.Precio.ToString("F2") €</td>
                        }
                    </tr>
                }

            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th>Total</th>
                    <th class="text-end">@total.ToString("F2") €</th>
                </tr>
            </tfoot>
        </table>

        <div class="mt-3">
            <strong>Método de pago:</strong> @ViewBag.OpcionPago
            @if (Model.OpcionPago == OpcionPago.Mixto)
            {
                <div class="mt-2">
                    <strong>Pago en efectivo:</strong> @Model.TotalEfectivo?.ToString("F2") €<br />
                    <strong>Pago con tarjeta:</strong> @Model.TotalTarjeta?.ToString("F2") €
                </div>
            }
            else if (Model.OpcionPago == OpcionPago.Efectivo)
            {
                <div class="mt-2">
                    <strong>Pago en efectivo:</strong> @Model.TotalEfectivo?.ToString("F2") €
                </div>
            }
            else if (Model.OpcionPago == OpcionPago.Tarjeta)
            {
                <div class="mt-2">
                    <strong>Pago con tarjeta:</strong> @Model.TotalTarjeta?.ToString("F2") €
                </div>
            }

        </div>

        <div class="mt-5 text-center">
            <em>Gracias por su visita</em>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between no-print">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
        <button class="btn btn-outline-dark" onclick="window.print()">
            <i class="fas fa-print me-1"></i> Imprimir Ticket
        </button>
    </div>
</div>
