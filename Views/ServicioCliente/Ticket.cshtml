@model PeluqueriaLuciaEspina.Models.ServicioCliente
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Ticket";
    var fechaCorta = Model.Fecha.ToString("dd/MM/yy");
    var servicios = Model.ServiciosRealizados.Where(s => s.ServicioGenerico != null).ToList();
    var total = servicios.Sum(s => s.ServicioGenerico!.Precio);
    var metodoPago = Model.OpcionPago switch {
        OpcionPago.Efectivo => "Contado (Efectivo)",
        OpcionPago.Tarjeta  => "Contado (Tarjeta)",
        OpcionPago.Mixto    => "Contado (Mixto)",
        _                   => "Contado"
    };
}

<div class="ticket-page-wrapper mt-3">

    <div id="ticket-servicio" class="ticket-receipt">

        <div class="text-center">
            <img src="~/Img/Icono_bn.png" alt="Logo" class="logo-ticket mb-1" />
        </div>
        <div class="text-center fw-bold" style="font-size:15px;">Lucia Peluqueria Ecologica</div>
        <div class="text-center">Oviedo</div>
        <div class="text-center">Tlf 659306659</div>
        <div class="text-center">C/Pio XII, 10</div>

        <div class="ticket-sep"></div>

        <div class="ticket-meta-row">
            <span>Fact. Simpli:@Model.Id</span>
            <span>@fechaCorta</span>
        </div>
        <div>Empleado: lucia espina</div>
        <div style="font-size:11px;color:#666;">NIF: 71678769M</div>

        <div class="ticket-sep"></div>

        <table class="ticket-table">
            <thead>
                <tr>
                    <th class="tc-uds">Uds</th>
                    <th class="tc-name">Descripcion</th>
                    <th class="tc-price">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in servicios)
                {
                    <tr>
                        <td class="tc-uds">1</td>
                        <td class="tc-name">@s.ServicioGenerico!.Nombre</td>
                        <td class="tc-price">@s.ServicioGenerico!.Precio.ToString("F2").Replace(".", ",")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="ticket-total-row">
                    <td class="tc-uds"></td>
                    <td class="tc-name text-end fw-bold">TOTAL</td>
                    <td class="tc-price fw-bold">@total.ToString("F2").Replace(".", ",")</td>
                </tr>
            </tfoot>
        </table>

        <div class="ticket-sep"></div>

        <table class="ticket-table">
            <thead>
                <tr>
                    <th>Tipo Imp</th>
                    <th class="text-end">Base</th>
                    <th class="text-end">Cuota</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0%</td>
                    <td class="text-end">@total.ToString("F2").Replace(".", ",")</td>
                    <td class="text-end">0,00</td>
                </tr>
            </tbody>
        </table>

        <div class="ticket-sep"></div>

        <div class="text-center fw-bold">
            @(Model.Estado == Estado.Cobrado ? metodoPago : "PENDIENTE DE COBRO")
        </div>
        <div class="text-center">Impuestos Incluidos</div>
        <div class="text-center">Gracias por su visita **</div>
    </div>

    <div class="ticket-side-panel no-print mt-3 d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
        <button class="btn btn-outline-dark btn-sm" onclick="window.print()">
            <i class="fas fa-print me-1"></i>Imprimir
        </button>
    </div>

</div>
