@model PeluqueriaLuciaEspina.Models.ServicioClienteViewModel
@using PelqueriaLuciaEspina.Enums
@using PeluqueriaLuciaEspina.Models
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Nuevo Servicio";
    var sexoSeleccionado = ViewBag.SexoSeleccionado as string ?? "";
}

<div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastNotificacion" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMensaje"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            @if (ViewBag.ErrorGeneral != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorGeneral
                </div>
            }

            <!-- Pantalla Selección de Sexo -->
            <div id="pantallaSexo" class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">¿Para quién es el servicio?</h5>
                </div>
                <div class="card-body text-center">
                    <div class="btn-group flex-wrap" role="group">
                        <button type="button" class="btn btn-outline-primary m-2 btn-sexo" data-sexo="0">
                            <i class="fas fa-mars me-2"></i> Hombre
                        </button>
                        <button type="button" class="btn btn-outline-danger m-2 btn-sexo" data-sexo="1">
                            <i class="fas fa-venus me-2"></i> Mujer
                        </button>
                        <button type="button" class="btn btn-outline-secondary m-2 btn-sexo" data-sexo="2">
                            <i class="fas fa-venus-mars me-2"></i> Otro
                        </button>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </div>

            <!-- Formulario multistep -->
            <form asp-action="Create" method="post" id="formServicio">
                <input type="hidden" name="sexoSeleccionado" value="@sexoSeleccionado" />

                <!-- Paso 1: Cliente + Fecha -->
                <div id="formularioServicio" class="card shadow-lg border-0 d-none">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-cut me-2"></i> Registrar servicio al cliente</h5>
                        <button class="btn btn-sm btn-outline-light volverSeleccionSexo" type="button">
                            <i class="fas fa-arrow-left me-1"></i> Cambiar sexo
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <label class="form-label fw-bolder">Cliente</label>
                                <select class="form-control" name="ClienteId" id="selectCliente"></select>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkSinCliente">
                                    <label class="form-check-label" for="chkSinCliente">
                                        Ticket sin cliente asociado
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label asp-for="Fecha" class="form-label fw-bolder">Fecha</label>
                                <div class="flatpickr" id="fechaWrap" data-input data-wrap>
                                    <div class="input-group">
                                        <input type="text" asp-for="Fecha" class="form-control bg-white" placeholder="Seleccionar fecha" data-input />
                                        <button class="btn btn-outline-secondary" type="button" title="Abrir calendario" data-toggle>
                                            <i class="fas fa-calendar-alt"></i>
                                        </button>
                                    </div>
                                </div>
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="text-end mt-3">
                            <button type="button" class="btn btn-primary" id="btnSiguiente">
                                <i class="fas fa-arrow-right me-1"></i> Siguiente
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Paso 2: Servicios -->
                <div id="pantallaServicios" class="card shadow-lg border-0 d-none">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-tags me-2"></i> Seleccionar servicios</h5>
                        <button type="button" class="btn btn-sm btn-outline-light volverPaso1">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row" id="contenedorServicios"></div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>Total:</strong>
                            <h4 class="mb-0 text-success" id="totalServicios">0,00 €</h4>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <button type="button" class="btn btn-primary" id="btnPaso3">
                            <i class="fas fa-arrow-right me-1"></i> Siguiente
                        </button>
                    </div>
                </div>

                <!-- Paso 3: Opción de Pago -->
                <div id="pantallaPago" class="card shadow-lg border-0 d-none">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i> Seleccionar método de pago</h5>
                        <button type="button" class="btn btn-sm btn-outline-light volverPaso2">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </button>
                    </div>
                    <div class="card-body">
                        @foreach (OpcionPago pago in Enum.GetValues(typeof(OpcionPago)))
                        {
                            var id = $"pago-{(int)pago}";
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="OpcionPago" id="@id" value="@( (int)pago )" @(pago == OpcionPago.Efectivo ? "checked" : "") />
                                <label class="form-check-label" for="@id">@pago.ToString()</label>
                            </div>
                        }
                    </div>
                    <div class="card-footer text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check-circle me-1"></i> Finalizar y guardar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const sexoInicial = '@sexoSeleccionado';

        $(document).ready(function () {
            flatpickr("#fechaWrap", {
                locale: {
                    firstDayOfWeek: 1,
                    weekdays: {
                        shorthand: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
                        longhand: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']
                    },
                    months: {
                        shorthand: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
                        longhand: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
                    }
                },
                dateFormat: "Y-m-d",
                defaultDate: "@(DateTime.Now.ToString("yyyy-MM-dd"))",
                altInput: true,
                altFormat: "d/m/Y",
                allowInput: true,
                wrap: true
            });

            const $pantallaSexo = $('#pantallaSexo');
            const $formulario = $('#formularioServicio');
            const $pantallaServicios = $('#pantallaServicios');
            const $pantallaPago = $('#pantallaPago');
            const $contenedorServicios = $('#contenedorServicios');

            $('#selectCliente').select2({
                theme: 'bootstrap-5',
                placeholder: "-- Selecciona cliente --",
                allowClear: true,
                width: '100%',
                language: {
                    noResults: () => "No se encontraron clientes"
                }
            });

            $('.btn-sexo').on('click', function () {
                const sexo = parseInt($(this).data('sexo'));
                $('input[name="sexoSeleccionado"]').val(sexo);
                $pantallaSexo.addClass('d-none');
                $formulario.removeClass('d-none');
                cargarClientesPorSexo(sexo);
            });

            $('.volverSeleccionSexo').on('click', function () {
                $formulario.addClass('d-none');
                $pantallaSexo.removeClass('d-none');
                $('#selectCliente').empty();
            });

            $('#chkSinCliente').on('change', function () {
                const sinCliente = $(this).is(':checked');
                $('#selectCliente').prop('disabled', sinCliente).val(null).trigger('change');
            });

            $('#btnSiguiente').on('click', function () {
                const sinCliente = $('#chkSinCliente').is(':checked');
                const clienteId = $('#selectCliente').val();
                const fecha = $('input[name="Fecha"]').val();
                const sexo = parseInt($('input[name="sexoSeleccionado"]').val());

                if (!sinCliente && !clienteId) {
                    mostrarToast("Por favor, selecciona cliente o marca \"Ticket sin cliente asociado\".");
                    return;
                }
                if (!fecha) {
                    mostrarToast("Por favor, selecciona fecha.");
                    return;
                }

                $formulario.addClass('d-none');
                $pantallaServicios.removeClass('d-none');
                renderServiciosFiltrados(sexo);
            });

            $('#btnPaso3').on('click', function () {
                const serviciosSeleccionados = $('.servicio-checkbox:checked').length;
                if (serviciosSeleccionados === 0) {
                    mostrarToast("Por favor, selecciona al menos un servicio.");
                    return;
                }

                $pantallaServicios.addClass('d-none');
                $pantallaPago.removeClass('d-none');
            });

            $('.volverPaso1').on('click', function () {
                $pantallaServicios.addClass('d-none');
                $formulario.removeClass('d-none');
                $contenedorServicios.empty();
            });

            $('.volverPaso2').on('click', function () {
                $pantallaPago.addClass('d-none');
                $pantallaServicios.removeClass('d-none');
            });

            function cargarClientesPorSexo(sexo) {
                $.ajax({
                    url: `/Clientes/ObtenerClientesPorSexo`,
                    method: 'GET',
                    data: { sexo: sexo },
                    success: function (data) {
                        const $select = $('#selectCliente');
                        $select.empty().append('<option value="">-- Selecciona cliente --</option>');
                        data.forEach(cliente => {
                            $select.append(`<option value="${cliente.id}">${cliente.nombre} ${cliente.apellido}</option>`);
                        });
                        $select.val('').trigger('change');
                    },
                    error: function () {
                        mostrarToast("Error al cargar los clientes.");
                    }
                });
            }

            function renderServiciosFiltrados(sexo) {
                $contenedorServicios.empty();
                $.ajax({
                    url: '/ServicioGenerico/ObtenerServiciosPorSexo',
                    method: 'GET',
                    data: { sexo: sexo },
                    success: function (servicios) {
                        if (!servicios || servicios.length === 0) {
                            $contenedorServicios.append(`
                                        <div class="col-12">
                                            <div class="alert alert-warning text-center">
                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                No hay servicios disponibles para este sexo.
                                            </div>
                                        </div>
                                    `);
                            calcularTotalServicios();
                            return;
                        }

                        servicios.forEach((s, i) => {
                            const precioInicial = parseFloat(s.precio).toFixed(2);
                            const html = `
                                        <div class="col-12 col-sm-6 mb-3 servicio-item">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="checkbox"
                                                       class="servicio-checkbox form-check-input me-2"
                                                       data-servicio-id="${s.id}"
                                                       id="serv-${s.id}"
                                                       value="${s.id}">
                                                <label for="serv-${s.id}" class="form-check-label fw-semibold flex-grow-1">
                                                    ${s.nombre}
                                                </label>
                                                <div class="input-group input-group-sm" style="width:120px;">
                                                    <input type="number"
                                                           step="0.01"
                                                           min="0.01"
                                                           class="form-control form-control-sm servicio-precio"
                                                           id="precio-${s.id}"
                                                           value="${precioInicial}"
                                                           disabled>
                                                    <span class="input-group-text">€</span>
                                                </div>
                                            </div>
                                        </div>`;
                            $contenedorServicios.append(html);
                        });

                        $('.servicio-checkbox').each(function () {
                            new Switchery(this, { color: '#0d6efd', size: 'small' });
                        });

                        calcularTotalServicios();
                    },
                    error: function () {
                        mostrarToast("Error al cargar los servicios para el sexo seleccionado.");
                    }
                });
            }

            $(document).on('change', '.servicio-checkbox', function () {
                const $precioInput = $(this).closest('.servicio-item').find('.servicio-precio');
                $precioInput.prop('disabled', !this.checked);
                calcularTotalServicios();
            });

            $(document).on('input', '.servicio-precio', calcularTotalServicios);

            function calcularTotalServicios() {
                let total = 0;
                $('.servicio-checkbox:checked').each(function () {
                    const precio = parseFloat($(this).closest('.servicio-item').find('.servicio-precio').val());
                    total += isNaN(precio) ? 0 : precio;
                });
                $('#totalServicios').text(total.toFixed(2) + " €");
            }

            // Antes de enviar, construye los campos ServiciosSeleccionados[i].ServicioGenericoId /
            // .Precio (con el precio editado en pantalla) solo para los servicios marcados.
            $('#formServicio').on('submit', function () {
                $('.hidden-servicio-input').remove();

                let index = 0;
                $('.servicio-checkbox:checked').each(function () {
                    const id = $(this).data('servicio-id');
                    const precio = parseFloat($(this).closest('.servicio-item').find('.servicio-precio').val()) || 0;

                    $('<input>').attr({
                        type: 'hidden',
                        class: 'hidden-servicio-input',
                        name: `ServiciosSeleccionados[${index}].ServicioGenericoId`,
                        value: id
                    }).appendTo(this.form);

                    $('<input>').attr({
                        type: 'hidden',
                        class: 'hidden-servicio-input',
                        name: `ServiciosSeleccionados[${index}].Precio`,
                        value: precio.toFixed(2).replace('.', ',')
                    }).appendTo(this.form);

                    index++;
                });
            });

            function mostrarToast(mensaje) {
                $('#toastMensaje').text(mensaje);
                const toast = new bootstrap.Toast(document.getElementById('toastNotificacion'), { delay: 4000 });
                toast.show();
            }

            if (sexoInicial) {
                $('input[name="sexoSeleccionado"]').val(sexoInicial);
                $pantallaSexo.addClass('d-none');
                $formulario.removeClass('d-none');
                cargarClientesPorSexo(sexoInicial);
            }
        });
    </script>
}
