@using PelqueriaLuciaEspina.Enums
@using PeluqueriaLuciaEspina.Models
@model IEnumerable<ServicioCliente>


@{
    ViewData["Title"] = "Servicios";

    var fechaSeleccionada = ViewBag.FechaSeleccionada as DateTime?;

    var total = Model.Sum(s => s.ServiciosRealizados
        .Where(sr => sr.ServicioGenerico != null)
        .Sum(sr => sr.ServicioGenerico!.Precio));

    var totalServicios = Model.Sum(s => s.ServiciosRealizados.Count);

    var totalCobrado = Model
    .Where(s => s.Estado == Estado.Cobrado)
    .Sum(s => s.ServiciosRealizados
        .Where(sr => sr.ServicioGenerico != null)
        .Sum(sr => sr.ServicioGenerico!.Precio));

    var totalVisitas = Model.Count();
    
}
<!-- Modal de confirmación -->
<div class="modal fade" id="modalEliminarServicio" tabindex="-1" aria-labelledby="modalEliminarServicioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarServicioLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Borrado
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que quieres borrar el servicio <strong id="nombreServicioEliminar"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a id="btnConfirmarEliminar" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i> Borrar
                </a>
            </div>
        </div>
    </div>
</div>


<div class="container mt-4">

    <div class="row align-items-start align-items-md-center mb-4 g-3">
        <div class="col-12 col-md-3">
            <h2 class="fw-bold mb-2">
                <i class="fas fa-calendar-alt text-primary me-2"></i>Servicios del día
            </h2>
        </div>

        <div class="col-12 col-md-9">
            <div class="row g-2">
                <!-- Calendario -->
                <div class="col-12 col-md-6">
                    <div class="flatpickr" id="fechaFiltroWrap" data-input data-wrap>
                        <div class="input-group">
                            <input type="text"
                                   id="fechaFiltro"
                                   class="form-control bg-white"
                                   placeholder="Seleccionar fecha"
                                   data-input />
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    title="Abrir calendario"
                                    data-toggle>
                                <i class="fas fa-calendar-alt"></i>
                            </button>
                        </div>
                    </div>


                </div>

                <!-- Botones -->
                <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-between">
                    <a class="btn btn-outline-primary w-100 mb-2 mb-md-0 me-md-2"
                       asp-action="Index"
                       asp-route-fecha="">
                        <i class="fas fa-list me-1"></i> Ver todos
                    </a>

                    <a class="btn btn-success  w-100" asp-action="Create">
                        <i class="fas fa-plus-circle me-1"></i> Nuevo Servicio
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-3">

        <div class="col">
            <div class="card shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body text-center">
                    <h6 class="card-title text-success">
                        <i class="fas fa-cut me-2"></i> Servicios Realizados
                    </h6>
                    <p class="display-6 text-success mb-0">@totalServicios</p>
                    <p class="text-muted small mb-0">Aplicados en el día</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body text-center">
                    <h6 class="card-title text-primary">
                        <i class="fas fa-euro-sign me-2"></i> Total Facturado
                    </h6>
                    <p class="display-6 text-primary mb-0">@total.ToString("F2") €</p>
                    <p class="text-muted small mb-0">Ingresos del día</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body text-center">
                    <h6 class="card-title text-warning">
                        <i class="fas fa-money-bill-wave me-2"></i> Total Cobrado
                    </h6>
                    <p class="display-6 text-warning mb-0">@totalCobrado.ToString("F2") €</p>
                    <p class="text-muted small mb-0">Pagado por clientes</p>
                </div>
            </div>
        </div>


        <div class="col">
            <div class="card shadow-sm h-100 border-start border-4 border-info">
                <div class="card-body text-center">
                    <h6 class="card-title text-info">
                        <i class="fas fa-users me-2"></i> Total Visitas
                    </h6>
                    <p class="display-6 text-info mb-0">@totalVisitas</p>
                    <p class="text-muted small mb-0">Clientes atendidos</p>
                </div>
            </div>
        </div>
    </div>


    <div class="row pb-3">
        <div class="col-12 col-md-2 ms-md-auto mt-3 mt-md-0">
            <a class="btn btn-outline-success w-100" asp-action="ExportarExcel" asp-route-fecha="@ViewBag.FechaSeleccionada">
                <i class="fas fa-file-excel me-1"></i> Exportar a Excel
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th><i class="fas fa-user"></i> Cliente</th>
                    <th><i class="fas fa-cut"></i> Servicios</th>
                    <th><i class="fas fa-euro-sign"></i> Total</th>
                    <th><i class="fas fa-calendar-day"></i> Fecha</th>
                    <th><i class="fas fa-tools"></i> Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(x => x.Fecha))
                {
                    var totalPrecio = item.ServiciosRealizados
                    .Where(sr => sr.ServicioGenerico != null)
                    .Sum(sr => sr.ServicioGenerico!.Precio);
                    var serviciosRealizados = item.ServiciosRealizados;
                    var nombre = item.Cliente?.Nombre ?? "Desconocido";
                    <tr>
                        <td class="text-nowrap">@(item.Cliente?.Nombre) @(item.Cliente?.Apellido)</td>
                        <td class="text-nowrap">
                            @serviciosRealizados.Count                       
                        </td>
                        <td class="fw-bold text-success text-nowrap">
                            @totalPrecio.ToString("F2") €
                        </td>
                        <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">
                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fas fa-eye me-1"></i> Ver
                                </a>

                                @if (item.Estado != Estado.Cobrado)
                                {
                                    <a class="btn btn-sm btn-outline-success btn-cobrar-servicio"
                                       asp-action="Cobrar" asp-route-id="@item.Id">
                                        <i class="fas fa-money-bill-wave me-1"></i> Cobrar
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger btn-eliminar-servicio"
                                       data-id="@item.Id"
                                       data-nombre="@nombre"
                                       href="#">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-success btn-cobrar-servicio"
                                       asp-action="Ticket" asp-route-id="@item.Id" title="Ver ticket">
                                        <i class="fas fa-receipt me-1"></i> Ver Ticket
                                    </a>
                                    <span class="badge bg-success d-flex align-items-center">
                                        <i class="fas fa-check-circle me-1"></i> Cobrado
                                    </span>
                                }
                            </div>

                        </td>
                    </tr>
                }

            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Navegación de páginas">
                <ul class="pagination justify-content-center mt-4">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-fecha="@ViewBag.FechaSeleccionada">
                            <i class="fas fa-angle-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-fecha="@ViewBag.FechaSeleccionada">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-fecha="@ViewBag.FechaSeleccionada">
                            <i class="fas fa-angle-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const btnVerTodos = document.querySelector('a[href*="asp-route-fecha"]');
            const inputFecha = document.getElementById('fechaFiltro');

            btnVerTodos?.addEventListener('click', function () {
                if (inputFecha) console.log("diego");
            });
            flatpickr("#fechaFiltroWrap", {
                locale: {
                    firstDayOfWeek: 1,
                    weekdays: {
                        shorthand: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
                        longhand: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
                    },
                    months: {
                        shorthand: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Оct', 'Nov', 'Dic'],
                        longhand: ['Enero', 'Febreo', 'Мarzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
                    },
                },
                dateFormat: "Y-m-d",
                @if (fechaSeleccionada != null)
                {
                    <text>defaultDate: "@fechaSeleccionada.Value.ToString("yyyy-MM-dd")", </text>
                }
                altInput: true,
                altFormat: "d/m/Y",
                allowInput: true,
                wrap: true,
                onChange: function (selectedDates, dateStr) {
                    if (dateStr) {
                        window.location.href = `@Url.Action("Index", "ServicioCliente")?fecha=${dateStr}`;
                    }
                }
            });
            $('.btn-eliminar-servicio').on('click', function (e) {
                e.preventDefault();

                const id = $(this).data('id');
                const nombre = $(this).data('nombre');

                $('#nombreServicioEliminar').text(nombre);
                $('#btnConfirmarEliminar').attr('href', `/ServicioCliente/Delete/${id}`);

                const modal = new bootstrap.Modal(document.getElementById('modalEliminarServicio'));
                modal.show();
            });
        });
    </script>

}
