@model PeluqueriaLuciaEspina.Models.ServicioGenerico
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Nuevo Servicio Genérico";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="fas fa-scissors me-2"></i>
                    <h5 class="mb-0">Registrar nuevo servicio</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bolder">Nombre del servicio</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Lavado, corte, peinado..." />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label fw-bolder">Precio (€)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="Ej. 15,00" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sexo" class="form-label fw-bolder">Orientado a</label>
                            <select asp-for="Sexo" class="form-select" asp-items="Html.GetEnumSelectList<Sexo>()"></select>
                            <span asp-validation-for="Sexo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Imagen (opcional)</label>
                            <input type="file" name="ImagenRuta" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-check-circle me-1"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
