@model PeluqueriaLuciaEspina.Models.ServicioGenerico
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Editar Servicio Genérico";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="fas fa-scissors me-2"></i>
                    <h5 class="mb-0">Editar servicio</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bolder">Nombre del servicio</label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label fw-bolder">Precio (€)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sexo" class="form-label fw-bolder">Orientado a</label>
                            <select asp-for="Sexo" class="form-select" asp-items="Html.GetEnumSelectList<Sexo>()"></select>
                            <span asp-validation-for="Sexo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bolder">Imagen actual</label><br />
                            @if (!string.IsNullOrEmpty(Model.ImagenRuta))
                            {
                                <img src="@Model.ImagenRuta" class="img-thumbnail" style="max-height: 120px;" />
                            }
                            else
                            {
                                <span class="text-muted">No hay imagen</span>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bolder">Cambiar imagen</label>
                            <input type="file" name="imagen" id="imagenInput" accept="image/*" class="form-control" />
                            <div class="form-text">Formatos aceptados: JPG, PNG. Tamaño máximo recomendado: 2MB.</div>
                        </div>

                        <!-- 🖼️ Previsualización de imagen nueva -->
                        <div class="mt-2" id="previewContainer" style="display:none;">
                            <label class="form-label fw-bolder">Previsualización:</label><br />
                            <img id="previewImagen" src="#" class="img-thumbnail" style="max-height: 120px;" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-save me-1"></i> Guardar cambios
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imagenInput').addEventListener('change', function (event) {
            const input = event.target;
            const file = input.files[0];

            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const previewImg = document.getElementById('previewImagen');
                    previewImg.src = e.target.result;
                    document.getElementById('previewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('previewContainer').style.display = 'none';
            }
        });
    </script>
}
