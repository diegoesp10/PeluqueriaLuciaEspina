@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<header class="bg-Lucia text-white py-3 mb-4 shadow-sm sticky-top">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="text-white text-decoration-none d-flex align-items-center" asp-controller="Servicios" asp-action="Index">
            <img src="~/Img/icono.jpg" alt="Logo Peluquería" class="me-2" style="height: 40px; width: auto;" />
            <h3 class="mb-0 fw-bold d-none d-md-block">Peluquería Lucía</h3>
        </a>
        <nav class="d-flex gap-4">
            <a class="nav-link text-white @(currentController == "Servicios" ? "fw-bold border-bottom border-white" : "opacity-75")"
               asp-controller="Servicios" asp-action="Index">
                <i class="fas fa-scissors me-1"></i> Servicios
            </a>
            <a class="nav-link text-white @(currentController == "CortePelo" ? "fw-bold border-bottom border-white" : "opacity-75")"
               asp-controller="CortePelo" asp-action="Index">
                <i class="fas fa-user me-1"></i> Cortes
            </a>
        </nav>
    </div>
</header>

