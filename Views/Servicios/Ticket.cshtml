@model PeluqueriaLuciaEspina.Models.Servicio
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Ticket del Servicio";
    string fechaFormateada = Model.FechaCreacion.ToString("dd/MM/yyyy") ?? "";
}
<div class="container mt-4">
    <div id="ticket-servicio" class="card shadow-sm border-0 p-4">
        <div class="ticket-header text-center mb-4">
            <img src="~/Img/Icono_bn.png" alt="Logo Peluquería B/N" class="logo-ticket mb-2" />
            <h5 class="fw-bold mb-1">Peluquería Lucía Espina</h5>
            <p class="mb-0 small">NIF: 71678769M</p>
            <p class="mb-0 small">Calle Pío XII, 10 Bajo 1 - Oviedo, Asturias</p>
        </div>

        <hr>

        <div class="mb-3">
            <strong>Nº Ticket:</strong> @Model.Id<br />
            <strong>Fecha:</strong> @fechaFormateada
        </div>

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Descripción</th>
                    <th class="text-end">Precio</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.Nombre</td>
                    <td class="text-end">@Model.Precio.ToString("F2") €</td>
                </tr>
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th>Total</th>
                    <th class="text-end">@Model.Precio.ToString("F2") €</th>
                </tr>
            </tfoot>
        </table>

        <div class="mt-3">
            <strong>Método de pago:</strong> @Model.OpcionPago
        </div>

        <div class="mt-5 text-center">
            <em>Gracias por su visita</em>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between no-print">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
        <button class="btn btn-outline-dark" onclick="window.print()">
            <i class="fas fa-print me-1"></i> Imprimir Ticket
        </button>
    </div>
</div>
