@model PeluqueriaLuciaEspina.Models.Servicio
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Cobrar Servicio";
    var opcionesPago = Enum.GetValues(typeof(OpcionPago)).Cast<OpcionPago>();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            @if (ViewBag.ErrorCobrando != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorCobrando
                </div>
            }
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="fas fa-euro-sign me-2"></i> Cobrar Servicio</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-light">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="CobrarConfirmado" asp-controller="Servicios" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del servicio</label>
                            <div class="form-control bg-light">@Model.Nombre</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Precio (€)</label>
                            <div class="form-control bg-light">@Model.Precio.ToString("F2") €</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OpcionPago" class="form-label fw-semibold">Forma de pago</label>
                            <select asp-for="OpcionPago" class="form-select" required>
                                <option value="">-- Selecciona método de pago --</option>
                                @foreach (var opcion in opcionesPago)
                                {
                                    <option value="@((int)opcion)">@opcion</option>
                                }
                            </select>
                            <span asp-validation-for="OpcionPago" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check-circle me-1"></i> Confirmar cobro
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
