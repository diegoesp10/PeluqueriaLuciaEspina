@model PeluqueriaLuciaEspina.Models.Servicio
@using PelqueriaLuciaEspina.Enums

@{
    ViewData["Title"] = "Crear Servicio";
    var cortesPelo = ViewBag.CortesPelo as List<PeluqueriaLuciaEspina.Models.CortePelo> ?? new();
    var sexoSeleccionado = ViewBag.SexoSeleccionado as string ?? "";
    var selectedCorteId = Model != null ? Model.CortePeloId?.ToString() ?? "" : "";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            @if (ViewBag.ErrorGeneral != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorGeneral
                </div>
            }
            <!-- Pantalla de Selección de Sexo -->
            <div id="pantallaSexo" class="card shadow-lg border-0 mb-4">

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">¿Para quién es el servicio?</h5>
                </div>
                <div class="card-body text-center">
                    <div class="btn-group flex-wrap" role="group">
                        <button type="button" class="btn btn-outline-primary m-2 btn-sexo" data-sexo="Hombre">
                            <i class="fas fa-mars me-2"></i> Hombre
                        </button>
                        <button type="button" class="btn btn-outline-danger m-2 btn-sexo" data-sexo="Mujer">
                            <i class="fas fa-venus me-2"></i> Mujer
                        </button>
                        <button type="button" class="btn btn-outline-secondary m-2 btn-sexo" data-sexo="Otro">
                            <i class="fas fa-venus-mars me-2"></i> Otro
                        </button>
                    </div>
                </div>
                <div class="card-footer d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <p class="text-muted mb-2 mb-md-0">Selecciona el sexo para filtrar los cortes de pelo disponibles.</p>
                    <a asp-action="Index" class="btn btn-sm btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>

            <!-- Formulario -->
            <div id="formularioServicio" class="card shadow-lg border-0 d-none">
                <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between">
                    <div><i class="fas fa-cut me-2"></i> Registrar nuevo servicio</div>
                    <button id="volverSeleccionSexo" class="btn btn-sm btn-outline-light">
                        <i class="fas fa-arrow-left me-1"></i> Cambiar sexo
                    </button>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="sexoSeleccionado" value="@sexoSeleccionado" />
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CortePeloId" class="form-label"> Corte de Pelo</label>
                            <select asp-for="CortePeloId" class="form-select select2" id="CortePeloId">
                                <option value="">-- Sin corte específico --</option>
                            </select>
                            <span asp-validation-for="CortePeloId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-check-circle me-1"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const cortesOriginales = JSON.parse('@Html.Raw(ViewBag.CortesPeloJson)');

            const $pantallaSexo = $('#pantallaSexo');
            const $formulario = $('#formularioServicio');
            const $corteSelect = $('#CortePeloId');
            const $volverBtn = $('#volverSeleccionSexo');
            const $inputNombre = $('#Nombre');
            const $inputPrecio = $('#Precio');
            const sexoInicial = '@sexoSeleccionado';
            const selectedId = '@selectedCorteId';

            function aplicarFiltroSexo(sexo) {
                $corteSelect.empty().append(`<option value="">-- Sin corte específico --</option>`);
                cortesOriginales.forEach(c => {
                    if (!sexo || c.sexo.toLowerCase() === sexo.toLowerCase()) {
                        const option = new Option(c.text, c.value);
                        $(option).attr('data-nombre', c.nombre);
                        $(option).attr('data-precio', c.precio);
                        $(option).attr('data-sexo', c.sexo);
                        if (c.value.toString() === selectedId) $(option).prop('selected', true);
                        $corteSelect.append(option);
                    }
                });
                $corteSelect.select2({ width: '100%' });
            }

            if (sexoInicial || '@ViewBag.ErrorGeneral' || '@Html.Raw(ViewData.ModelState.IsValid.ToString())' === 'False') {
                $pantallaSexo.addClass('d-none');
                $formulario.removeClass('d-none');
                aplicarFiltroSexo(sexoInicial);
            }

            $('.btn-sexo').on('click', function () {
                const sexo = $(this).data('sexo');
                $('input[name="sexoSeleccionado"]').val(sexo);
                $pantallaSexo.addClass('d-none');
                $formulario.removeClass('d-none');
                aplicarFiltroSexo(sexo);
            });

            $volverBtn.on('click', function (e) {
                e.preventDefault();
                $pantallaSexo.removeClass('d-none');
                $formulario.addClass('d-none');
                $corteSelect.select2('destroy').empty().append('<option value="">-- Sin corte específico --</option>');
                $inputNombre.val('').prop('readonly', false).removeClass('bg-light');
                $inputPrecio.val('').prop('readonly', false).removeClass('bg-light');
            });

            $corteSelect.on('change', function () {
                const selected = $(this).find('option:selected');
                const nombre = selected.data('nombre');
                const precio = selected.data('precio');

                if (selected.val()) {
                    if (nombre && $inputNombre.val().trim() === '') {
                        $inputNombre.val(nombre).prop('readonly', true).addClass('bg-light');
                    }
                    if (precio) {
                        $inputPrecio.val(precio).prop('readonly', true).addClass('bg-light');
                    }
                } else {
                    $inputNombre.val('').prop('readonly', false).removeClass('bg-light');
                    $inputPrecio.val('').prop('readonly', false).removeClass('bg-light');
                }
            });
        });
    </script>
}
