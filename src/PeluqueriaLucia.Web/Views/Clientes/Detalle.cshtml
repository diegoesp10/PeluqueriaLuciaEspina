@model ClienteDetalleModelo
@{
    var c = Model.Cliente;
    var r = Model.Resumen;
    var p = Model.Visitas;
    ViewData["Title"] = c.NombreCompleto;
    ViewData["MostrarFecha"] = true;
}

<div>
    <a class="back-link" asp-action="Index"><icono nombre="anterior" tamano="20" /> Clientes</a>
    <header class="page-head">
        <div class="titulo-con-avatar">
            <span class="avatar avatar-lg @Formato.Tinte(c.Sexo)">@c.Iniciales</span>
            <div>
                <h1>@c.NombreCompleto</h1>
                <p class="subtitle">@Formato.Texto(c.Sexo) · Cliente desde @c.FechaCreacion.ToString("MMMM 'de' yyyy", Formato.Espanol)</p>
            </div>
        </div>
        <div class="acciones">
            <a class="btn btn-gray" asp-action="Editar" asp-route-id="@c.Id"><icono nombre="editar" tamano="17" /> Editar</a>
            <a class="btn btn-primary" asp-controller="Visitas" asp-action="Nueva" asp-route-clienteId="@c.Id"><icono nombre="mas" tamano="18" /> Nueva visita</a>
        </div>
    </header>

    <div class="detalle-grid">
        <section>
            <div class="section-head"><h2>Contacto</h2></div>
            <div class="list">
                <div class="row row-kv">
                    <span><icono nombre="telefono" tamano="16" /> Teléfono</span>
                    @if (c.Telefono is not null)
                    {
                        <a class="enlace num" href="tel:@c.Telefono">@c.Telefono</a>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </div>
                <div class="row row-kv">
                    <span><icono nombre="email" tamano="16" /> Email</span>
                    @if (c.Email is not null)
                    {
                        <a class="enlace truncate" href="mailto:@c.Email">@c.Email</a>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </div>
            </div>

            @if (r.Visitas == 0)
            {
                <form class="section" method="post" asp-action="Eliminar" asp-route-id="@c.Id"
                      data-confirmar="@c.NombreCompleto se borrará de tus clientes. No se puede deshacer.">
                    <button class="btn btn-gray btn-destructive btn-block"><icono nombre="papelera" tamano="17" /> Eliminar cliente</button>
                </form>
            }
        </section>

        <section>
            <div class="section-head"><h2>Resumen</h2></div>
            <div class="stats stats-2">
                <div class="stat tint-purple">
                    <span class="stat-label"><icono nombre="calendario" tamano="16" /> Visitas</span>
                    <span class="stat-value">@r.Visitas</span>
                </div>
                <div class="stat tint-blue">
                    <span class="stat-label"><icono nombre="euro" tamano="16" /> Gastado</span>
                    <span class="stat-value">@Formato.Euros(r.Facturado)</span>
                    @if (r.Pendiente > 0)
                    {
                        <span class="stat-foot">@Formato.Euros(r.Pendiente) pendiente</span>
                    }
                </div>
            </div>
        </section>
    </div>

    <section class="section">
        <div class="section-head"><h2>Historial</h2></div>
        @if (p.TotalElementos == 0)
        {
            <div class="estado-vacio">
                <p>@c.Nombre todavía no tiene visitas.</p>
            </div>
        }
        else
        {
            <div class="list list-avatars">
                @foreach (var v in p.Elementos)
                {
                    <partial name="~/Views/Visitas/_FilaVisita.cshtml" model="v" view-data="ViewData" />
                }
            </div>
            <partial name="_Paginacion" model="@(new PaginacionModelo(p.Numero, p.TotalPaginas, p.TotalElementos, n => Url.Action("Detalle", new { id = c.Id, pagina = n })!))" />
        }
    </section>
</div>
