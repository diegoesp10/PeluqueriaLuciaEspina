@model ReservaPagina
@{
    ViewData["Title"]=T["Tu próxima cita"];
    var seleccion=Model.Disponibilidad.Dia;
    var inicio=new DateOnly(seleccion.Year,seleccion.Month,1);
    var desplazamiento=((int)inicio.DayOfWeek+6)%7;
    var anterior=inicio.AddMonths(-1); var siguiente=inicio.AddMonths(1);
    var citas=Url.Action("Index","Agenda");
    var servicio=Model.Formulario.ServicioId;
    var otro=Model.Formulario.ServicioOtro;
    // Para quién es la cita: lo elegido arriba o, al volver con errores, el sexo que se envió
    var para=Model.Formulario.Para ?? Model.Formulario.Sexo?.ToString();
    // Los enlaces del calendario conservan el servicio, lo escrito y el filtro
    string Enlace(DateOnly d) => $"{citas}?dia={d:yyyy-MM-dd}&servicioId={servicio}" + (string.IsNullOrEmpty(otro) ? "" : "&otro=" + Uri.EscapeDataString(otro)) + (para is null ? "" : "&para=" + para);
}
<section class="seccion-publica agenda-intro"><div><p class="etiqueta" data-anima="subir">@T["UN MOMENTO PARA TI"]</p><h1 data-dividir>@T["Tu próximo cuidado,"]<br /><em>@T["a un paso."]</em></h1><p class="intro" data-anima="subir">@T["Elige un día y una hora. El equipo del salón se pondrá en contacto contigo para revisar el servicio y confirmar tu cita."]</p></div><div class="agenda-sello" data-anima="subir"><img src="~/Img/Icono.jpg" alt="Lucía Peluquería Ecológica" width="150" height="150" data-flotar /><p>@T["Tiempo para escucharte."]<br />@T["Cuidado para tu cabello."]</p></div></section>
<section class="seccion-publica agenda-publica">
    <div class="agenda-calendario card" data-anima="subir">
        <form method="get" action="@citas" class="agenda-servicio">
            <label for="dia-agenda">@T["Día de tu cita"]</label><input id="dia-agenda" type="date" name="dia" value="@seleccion.ToString("yyyy-MM-dd")" min="@Model.Hoy.ToString("yyyy-MM-dd")" max="@Model.Hoy.AddDays(90).ToString("yyyy-MM-dd")" />
            @* Con JavaScript (agenda-publica.js): filtro por público, búsqueda al escribir y texto libre si el servicio no está en la lista *@
            @* «¿Para quién es la cita?» es el sexo de la reserva (campo oculto del formulario de al lado) y filtra los cuidados *@
            <fieldset class="agenda-para" data-para hidden><legend>@T["¿Para quién es la cita?"]</legend><div class="segmented segmented-block">@foreach(var valor in new[]{"Hombre","Mujer","Otro"}){<label><input type="radio" name="para" value="@valor" checked="@(para==valor)" /> @T[valor]</label>}</div><p class="agenda-para-aviso" role="alert" data-para-aviso hidden>@T["Indica para quién es la cita: hombre, mujer u otro."]</p>@Html.ValidationMessage("Formulario.Sexo")</fieldset>
            <label for="servicio-agenda">@T["¿Qué cuidado te apetece?"]</label>
            <select id="servicio-agenda" name="servicioId" data-buscable="@T["Busca tu cuidado: corte, color, manicura…"]" data-buscable-vacio="@T["No hay cuidados con ese texto. Escríbelo y pregúntanos."]" data-buscable-libre="otro" data-buscable-libre-texto="@T["Preguntar por «{0}»"]"><option value="">@T["Consultar en la peluquería"]</option>@foreach(var s in Model.Servicios){<option value="@s.Id" data-sexo="@s.Sexo" selected="@(servicio==s.Id)">@s.Nombre · @s.Minutos min</option>}</select>
            <div class="agenda-otro" data-buscable-libre-campo><label for="otro-agenda">@T["¿No lo encuentras? Escríbelo o pregúntanos"]</label><input id="otro-agenda" name="otro" value="@otro" maxlength="80" autocomplete="off" /></div>
            <button class="btn btn-gray" type="submit">@T["Ver disponibilidad"]</button>
        </form>
        <div class="agenda-mes"><a class="btn btn-gray" href="@Enlace(anterior<Model.Hoy?Model.Hoy:anterior)" aria-label="@T["Mes anterior"]"><icono nombre="anterior" tamano="18" /></a><h2>@inicio.ToString("MMMM yyyy")</h2><a class="btn btn-gray" href="@Enlace(siguiente)" aria-label="@T["Mes siguiente"]"><icono nombre="siguiente" tamano="18" /></a></div>
        <div class="agenda-dias" aria-label="@T["Calendario de citas"]">
            @foreach(var nombre in Textos.EnIngles ? new[]{"M","T","W","T","F","S","S"} : new[]{"L","M","X","J","V","S","D"}){<span class="agenda-semana" aria-hidden="true">@nombre</span>}
            @for(var i=0;i<desplazamiento;i++){<span></span>}
            @for(var i=1;i<=DateTime.DaysInMonth(inicio.Year,inicio.Month);i++){
                var d=inicio.AddDays(i-1); var disponible=d>=Model.Hoy&&d<=Model.Hoy.AddDays(90);
                if(disponible){<a class="agenda-dia @(d==seleccion?"seleccionado":"")" href="@Enlace(d)" aria-current="@(d==seleccion?"date":null)" aria-label="@d.ToString("dddd d MMMM yyyy")">@i</a>}
                else{<span class="agenda-dia deshabilitado">@i</span>}
            }
        </div>
        <p class="nota">@T["Horario del salón · Oviedo. La disponibilidad se comprueba de nuevo al enviar."]</p>
    </div>
    <form method="post" action="@citas" class="card agenda-formulario" data-anima="subir" data-contacto-publico="@(ViewData["ContactoVerificable"] is true ? "true" : "false")" data-url-solicitar="@Url.Action("SolicitarContacto","Agenda")" data-url-verificar="@Url.Action("VerificarContacto","Agenda")">
        @Html.AntiForgeryToken()
        <h2>@seleccion.ToString(Textos.EnIngles ? "dddd, d MMMM" : "dddd, d 'de' MMMM")</h2>
        <p>@T["Tu cuidado empieza aquí."]</p>
        <div asp-validation-summary="All" role="alert"></div>
        <input asp-for="Formulario.SolicitudId" type="hidden" /><input type="hidden" name="Formulario.Dia" value="@seleccion.ToString("yyyy-MM-dd")" /><input asp-for="Formulario.ServicioId" type="hidden" /><input asp-for="Formulario.ServicioOtro" type="hidden" />
        <div class="agenda-trampa" aria-hidden="true"><label>Web<input name="Formulario.Web" tabindex="-1" autocomplete="off" /></label></div>
        <fieldset class="agenda-horas"><legend>@T["Elige una hora"]</legend>@foreach(var h in Model.Disponibilidad.Horas.Concat(Model.Disponibilidad.Ocupadas ?? []).Distinct().Order()){
            if(Model.Disponibilidad.Horas.Contains(h)){<label><input type="radio" name="Formulario.Hora" value="@h.ToString("HH:mm")" checked="@(Model.Formulario.Hora==h)" required /><span>@h.ToString("HH:mm")</span></label>}
            else{<label class="agenda-hora-ocupada"><input type="radio" disabled aria-label="@h.ToString("HH:mm"), @T["ocupado"]" /><span>@h.ToString("HH:mm") · @T["Ocupado"]</span></label>}
        }</fieldset>
        @if(Model.Disponibilidad.Horas.Count==0){<div class="agenda-sin-huecos">@T["Este día no tiene huecos disponibles para el cuidado elegido. Prueba otro día."]</div>}
        <div class="form-field"><label asp-for="Formulario.Telefono">@T["Móvil de contacto"]</label><input asp-for="Formulario.Telefono" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="612 345 678" required /><small>@T["Móvil español, con o sin +34. Te llamaremos para validar la reserva."]</small></div>
        <div class="form-field"><label asp-for="Formulario.Correo">@T["Correo electrónico"]</label><input asp-for="Formulario.Correo" type="email" autocomplete="email" maxlength="254" placeholder="@T["tu@correo.es"]" required /><small>@T["Necesitamos tu teléfono y correo para gestionar la reserva."]</small></div>
        <section class="agenda-verificar-contacto" aria-label="@T["Autocompletar tus datos"]">
            @if(ViewData["ContactoVerificable"] is true){
                <p class="nota">@T["Si ya has venido al salón, al escribir tu móvil y tu correo te enviaremos un código al correo de tu ficha para rellenar tus datos. Si es tu primera visita, rellénalos tú."]</p>
                <div data-contacto-desafio hidden><div class="form-field"><label for="codigo-contacto">@T["Código recibido por correo"]</label><input id="codigo-contacto" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /><small>@T["Caduca en 10 minutos. Comprueba también el correo no deseado."]</small></div><div class="agenda-botones"><button type="button" class="btn btn-gray" data-contacto-verificar>@T["Verificar y autocompletar"]</button><button type="button" class="btn btn-gray" data-contacto-solicitar>@T["Solicitar otro código"]</button></div></div>
            }else{<p class="nota">@T["Puedes completar tus datos manualmente. El autocompletado por verificación de correo no está disponible temporalmente."]</p>}
            <p class="nota" role="status" aria-live="polite" data-contacto-estado hidden></p>
        </section>
        <div class="form-field"><label asp-for="Formulario.Nombre">@T["Nombre o apodo"]</label><input asp-for="Formulario.Nombre" autocomplete="given-name" maxlength="100" required /></div>
        <div class="form-field"><label asp-for="Formulario.Apellido">@T["Apellidos"]</label><input asp-for="Formulario.Apellido" autocomplete="family-name" maxlength="100" required /></div>
        <input type="hidden" name="Formulario.Sexo" value="@para" data-sexo-cita />
        <fieldset class="agenda-horas"><legend>@T["¿Dónde prefieres recibir la propuesta y confirmar tu cita?"]</legend>
            <label><input asp-for="Formulario.Canal" id="canal-correo" type="radio" value="Correo" required /><span>@T["Correo electrónico"]</span></label>
            <label><input asp-for="Formulario.Canal" id="canal-whatsapp" type="radio" value="WhatsApp" required /><span>WhatsApp</span></label>
        </fieldset>
        <label class="agenda-consentimiento"><input asp-for="Formulario.Consentimiento" required /> <span>@T["Acepto que el salón use mi teléfono y correo para gestionar esta cita y contactar por el canal elegido."] <a asp-controller="Legal" asp-action="Privacidad" target="_blank">@T["Política de privacidad"]</a> · <a asp-controller="Legal" asp-action="Terminos" target="_blank">@T["Términos y condiciones"]</a></span></label>
        <button class="btn btn-primary btn-block" type="submit" disabled="@(Model.Disponibilidad.Horas.Count==0)">@T["Solicitar mi cita"] <icono nombre="flecha" tamano="14" /></button>
        <p class="nota">@T["El equipo revisará tu solicitud y te enviará una propuesta por el canal elegido. La cita quedará confirmada cuando la aceptes en el enlace recibido. Las solicitudes sin revisar caducan en 24 horas. Tus datos nunca se muestran al público."]</p>
    </form>
</section>

@section Scripts {
    <script src="~/js/agenda-navegacion.js" asp-append-version="true"></script>
    <script src="~/js/select-buscable.js" asp-append-version="true"></script>
    <script src="~/js/agenda-publica.js" asp-append-version="true"></script>
    <script src="~/js/contacto-publico.js" asp-append-version="true"></script>
}
