@{ViewData["Title"]=T["Solicitud recibida"];}
<section class="seccion-publica agenda-recibida"><img src="~/Img/Icono.jpg" alt="Lucía" width="120" height="120" data-flotar /><p class="etiqueta" data-anima="subir">@T["SOLICITUD RECIBIDA"]</p><h1 data-dividir>@T["Tu momento,"]<br /><em>@T["un poquito más cerca."]</em></h1><p class="intro" data-anima="subir">@T["Tu solicitud se ha recibido. El equipo del salón revisará el servicio y te enviará una propuesta por correo electrónico o WhatsApp, según el canal que has elegido. Acepta la propuesta en el enlace recibido para confirmar la cita."]</p><p data-anima="subir">@T["Esta solicitud aún no es una cita confirmada. Si no recibes respuesta en 24 horas, contacta con el salón."]</p><a class="btn btn-primary" asp-controller="Inicio" asp-action="Index" data-anima="subir">@T["Volver al salón"]</a></section>
