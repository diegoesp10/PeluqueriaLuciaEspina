@model AceptacionPagina
@{ ViewData["Title"] = T["Confirmar tu cita"]; }
<section class="seccion-publica agenda-recibida">
    <img src="~/Img/Icono.jpg" alt="Lucía Peluquería Ecológica" width="120" height="120" data-flotar />
    <p class="etiqueta" data-anima="subir">@T["TU PRÓXIMO CUIDADO"]</p>
    @if (Model.Propuesta is { } p)
    {
        <h1 data-dividir>@T["Tu momento,"]<br /><em>@T["listo para confirmar."]</em></h1>
        <p class="intro">@p.Servicio</p><p><strong>@p.Inicio.ToString(Textos.EnIngles ? "dddd d MMMM yyyy" : "dddd d 'de' MMMM yyyy") · @p.Inicio.ToString("HH:mm")–@p.Fin.ToString("HH:mm")</strong></p>
        <p>@T.F("Duración: {0} minutos. Pulsa el botón para aceptar la cita.", (int)(p.Fin - p.Inicio).TotalMinutes)</p>
        <form method="post" action="@Url.Action("Aceptar", "Agenda", new { token = Model.Token })">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">@T["Aceptar cita"]</button></form>
        <p class="nota">@T.F("Propuesta válida hasta {0}. Si necesitas cambios, contacta con el equipo.", TimeZoneInfo.ConvertTimeFromUtc(p.CaducaUtc, TimeZoneInfo.FindSystemTimeZoneById("Europe/Madrid")).ToString("dd/MM/yyyy HH:mm"))</p>
    }
    else
    {
        <h1 data-dividir>@T["Revisemos"]<br /><em>@T["tu próxima cita."]</em></h1><p class="intro">@T["Este enlace ha caducado, ya se ha utilizado o la propuesta ha cambiado. Contacta con el equipo para revisar tu reserva."]</p>
        <div asp-validation-summary="All" role="alert"></div><a class="btn btn-primary" href="@(Url.Content("~/"))#contacto">@T["Contactar con el equipo"]</a>
    }
</section>
