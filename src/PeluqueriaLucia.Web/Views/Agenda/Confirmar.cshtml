@model AceptacionPagina
@{ ViewData["Title"] = "Confirmar tu cita"; }
<section class="seccion-publica agenda-recibida">
    <img src="~/Img/Icono.jpg" alt="Lucía Peluquería Ecológica" width="120" height="120" />
    <p class="etiqueta">TU PRÓXIMO CUIDADO</p>
    @if (Model.Propuesta is { } p)
    {
        <h1>Tu momento,<br /><em>listo para confirmar.</em></h1>
        <p class="intro">@p.Servicio</p><p><strong>@p.Inicio.ToString("dddd d 'de' MMMM yyyy") · @p.Inicio.ToString("HH:mm")–@p.Fin.ToString("HH:mm")</strong></p>
        <p>Duración: @((int)(p.Fin - p.Inicio).TotalMinutes) minutos. Pulsa el botón para aceptar la cita.</p>
        <form method="post" action="/citas/confirmar/@Model.Token">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">Aceptar cita</button></form>
        <p class="nota">Propuesta válida hasta @TimeZoneInfo.ConvertTimeFromUtc(p.CaducaUtc, TimeZoneInfo.FindSystemTimeZoneById("Europe/Madrid")).ToString("dd/MM/yyyy HH:mm"). Si necesitas cambios, contacta con el equipo.</p>
    }
    else
    {
        <h1>Revisemos<br /><em>tu próxima cita.</em></h1><p class="intro">Este enlace ha caducado, ya se ha utilizado o la propuesta ha cambiado. Contacta con el equipo para revisar tu reserva.</p>
        <div asp-validation-summary="All" role="alert"></div><a class="btn btn-primary" href="/#contacto">Contactar con el equipo</a>
    }
</section>
