@model PeluqueriaLucia.Web.Models.OpinionesModelo
@{ ViewData["Title"] = T["Opiniones del salón"]; var opiniones = Model.Opiniones; var f = Model.Formulario; }
<section class="seccion-publica opiniones-portada">
    <div><p class="etiqueta" data-anima="subir">@T["EXPERIENCIAS REALES · VISITAS VERIFICADAS"]</p><h1 data-dividir>@T["Tu experiencia."]<br /><em>@T["Tu voz."]</em></h1><p class="intro" data-anima="subir">@T["El cuidado también se cuenta. Descubre cómo se han sentido quienes han pasado por nuestro salón."]</p></div>
    <div class="valoracion-salon" data-anima="subir">
        @if(opiniones.Total > 0) { <strong>@opiniones.Media.ToString("0.0")<small> / 5</small></strong><p>★ ★ ★ ★ ★</p><span>@(opiniones.Total == 1 ? T["1 opinión publicada"] : T.F("{0} opiniones publicadas", opiniones.Total))</span> }
        else { <strong>@T["Tu voz"]<br /><em>@T["cuenta."]</em></strong><p>@T["Aún no hay opiniones publicadas."]</p> }
        <a class="btn btn-primary" href="#dejar-opinion" data-magnetico>@T["Compartir mi experiencia"] →</a>
    </div>
</section>
<section class="seccion-publica opiniones-lista">
    @if(opiniones.Pagina.Elementos.Count == 0) { <p class="muted">@T["Cada opinión comienza con una visita. Comparte la tuya con el código de tu ticket."]</p> }
    <div class="resenas-grid" data-anima-grupo>@foreach(var opinion in opiniones.Pagina.Elementos) { <article class="resena-card"><div class="resena-cabecera"><strong>@opinion.Alias</strong><span>@opinion.Fecha.ToLocalTime().ToString("dd MMM yyyy")</span></div><p class="resena-estrellas" aria-label="@T.F("{0} de 5 estrellas", opinion.Estrellas)">@(new string('★', opinion.Estrellas))@(new string('☆', 5 - opinion.Estrellas))</p><span class="resena-verificada">✓ @T["Visita verificada"]</span><p class="resena-comentario">@opinion.Comentario</p>@if(opinion.Foto is not null) { <img class="resena-foto" src="@Url.Content("~" + opinion.Foto)" alt="@T.F("Peinado compartido por {0}", opinion.Alias)" loading="lazy" /> }@if(opinion.Respuesta is not null) { <div class="resena-respuesta"><strong>@T["Respuesta del equipo"]</strong><p>@opinion.Respuesta</p></div> }</article> }</div>
    @if(opiniones.Pagina.TotalPaginas > 1) { <nav class="pager" aria-label="@T["Páginas de opiniones"]">@if(opiniones.Pagina.HayAnterior) { <a class="btn btn-gray" asp-route-pagina="@(opiniones.Pagina.Numero - 1)">@T["Anterior"]</a> }<span>@opiniones.Pagina.Numero / @opiniones.Pagina.TotalPaginas</span>@if(opiniones.Pagina.HaySiguiente) { <a class="btn btn-gray" asp-route-pagina="@(opiniones.Pagina.Numero + 1)">@T["Siguiente"]</a> }</nav> }
</section>
<section class="seccion-publica opinion-escribir" id="dejar-opinion">
    <div><p class="etiqueta" data-anima="subir">@T["UN MOMENTO PARA COMPARTIR"]</p><h2 data-dividir>@T["¿Cómo te"]<br /><em>@T["has sentido?"]</em></h2><p data-anima="subir">@T["En tu ticket cobrado encontrarás un código para dejar una opinión, válido durante seis meses y una sola vez. No mostraremos ningún dato de tu ticket ni de tu visita."]</p><p data-anima="subir">@T["Tu comentario y tu foto se revisarán antes de publicarse. Usa un nombre que quieras mostrar y sube solo una foto tuya o que tengas permiso para compartir."]</p></div>
    <form class="card card-pad form-opinion" method="post" enctype="multipart/form-data" asp-action="Index" data-anima="subir"><div asp-validation-summary="All" role="alert"></div>@if(TempData["opinion-enviada"] is true) { <p class="aviso-opinion" role="status">@T["Gracias por compartirlo. Tu opinión está pendiente de revisión."]</p> }<div class="fields">
        <div class="field"><label for="Codigo">@T["Código de tu ticket"]</label><input class="input" name="Codigo" id="Codigo" value="@f.Codigo" required maxlength="64" autocomplete="off" /><p class="field-hint">@T["Solo verifica que has visitado el salón."]</p></div>
        <div class="field"><label for="Alias">@T["Nombre público"]</label><input class="input" name="Alias" id="Alias" value="@f.Alias" required minlength="2" maxlength="50" /></div>
        <fieldset class="opinion-puntuacion"><legend>@T["Tu valoración"]</legend><div>@for(var i = 1; i <= 5; i++) { <label><input type="radio" name="Estrellas" value="@i" checked="@(f.Estrellas == i)" required /><span>@i ★</span></label> }</div></fieldset>
        <div class="field"><label for="Comentario">@T["Cuéntanos tu experiencia"]</label><textarea class="input" id="Comentario" name="Comentario" rows="5" minlength="10" maxlength="1500" required>@f.Comentario</textarea></div>
        <div class="field"><label for="Foto">@T["Foto de tu peinado · opcional"]</label><input class="input" id="Foto" name="Foto" type="file" accept="image/jpeg,image/png,image/webp" /><p class="field-hint">@T["JPG, PNG o WebP. Hasta 5 MB. Quitaremos los metadatos de la imagen."]</p></div>
        <label class="check-opcion"><input type="checkbox" name="Consentimiento" value="true" required checked="@f.Consentimiento" /> <span>@T["Autorizo publicar mi opinión y, si la adjunto, mi foto. He evitado datos personales de otras personas."] <a asp-controller="Legal" asp-action="Terminos" asp-fragment="opiniones" target="_blank">@T["Términos y condiciones"]</a></span></label></div><button class="btn btn-primary" type="submit">@T["Enviar mi opinión"] →</button></form>
</section>
