@model PeluqueriaLucia.Web.Models.OpinionesModelo
@{ ViewData["Title"] = "Opiniones del salón"; var opiniones = Model.Opiniones; var f = Model.Formulario; }
<section class="seccion-publica opiniones-portada"><div><p class="etiqueta">EXPERIENCIAS REALES · VISITAS VERIFICADAS</p><h1>Tu experiencia.<br /><em>Tu voz.</em></h1><p class="intro">El cuidado también se cuenta. Descubre cómo se han sentido quienes han pasado por nuestro salón.</p></div><div class="valoracion-salon">@if(opiniones.Total > 0) { <strong>@opiniones.Media.ToString("0.0")<small> / 5</small></strong><p>★ ★ ★ ★ ★</p><span>@(opiniones.Total == 1 ? "1 opinión publicada" : $"{opiniones.Total} opiniones publicadas")</span> } else { <strong>Tu voz<br /><em>cuenta.</em></strong><p>Aún no hay opiniones publicadas.</p> }<a class="btn btn-primary" href="#dejar-opinion">Compartir mi experiencia →</a></div></section>
<section class="seccion-publica opiniones-lista">@if(opiniones.Pagina.Elementos.Count == 0) { <p class="muted">Cada opinión comienza con una visita. Comparte la tuya con el código de tu ticket.</p> }<div class="resenas-grid">@foreach(var opinion in opiniones.Pagina.Elementos) { <article class="resena-card"><div class="resena-cabecera"><strong>@opinion.Alias</strong><span>@opinion.Fecha.ToLocalTime().ToString("dd MMM yyyy")</span></div><p class="resena-estrellas" aria-label="@opinion.Estrellas de 5 estrellas">@(new string('★', opinion.Estrellas))@(new string('☆', 5 - opinion.Estrellas))</p><span class="resena-verificada">✓ Visita verificada</span><p class="resena-comentario">@opinion.Comentario</p>@if(opinion.Foto is not null) { <img class="resena-foto" src="@opinion.Foto" alt="Peinado compartido por @opinion.Alias" loading="lazy" /> }@if(opinion.Respuesta is not null) { <div class="resena-respuesta"><strong>Lucía responde</strong><p>@opinion.Respuesta</p></div> }</article> }</div>@if(opiniones.Pagina.TotalPaginas > 1) { <nav class="pager" aria-label="Páginas de opiniones">@if(opiniones.Pagina.HayAnterior) { <a class="btn btn-gray" asp-route-pagina="@(opiniones.Pagina.Numero - 1)">Anterior</a> }<span>@opiniones.Pagina.Numero / @opiniones.Pagina.TotalPaginas</span>@if(opiniones.Pagina.HaySiguiente) { <a class="btn btn-gray" asp-route-pagina="@(opiniones.Pagina.Numero + 1)">Siguiente</a> }</nav> }</section>
<section class="seccion-publica opinion-escribir" id="dejar-opinion"><div><p class="etiqueta">UN MOMENTO PARA COMPARTIR</p><h2>¿Cómo te<br /><em>has sentido?</em></h2><p>En tu ticket cobrado encontrarás un código para dejar una opinión, válido durante seis meses y una sola vez. No mostraremos ningún dato de tu ticket ni de tu visita.</p><p>Tu comentario y tu foto se revisarán antes de publicarse. Usa un nombre que quieras mostrar y sube solo una foto tuya o que tengas permiso para compartir.</p></div><form class="card card-pad form-opinion" method="post" enctype="multipart/form-data" asp-action="Index"><div asp-validation-summary="All" role="alert"></div>@if(TempData["opinion-enviada"] is true) { <p class="aviso-opinion" role="status">Gracias por compartirlo. Tu opinión está pendiente de revisión.</p> }<div class="fields">
<div class="field"><label for="Codigo">Código de tu ticket</label><input class="input" name="Codigo" id="Codigo" value="@f.Codigo" required maxlength="64" autocomplete="off" /><p class="field-hint">Solo verifica que has visitado el salón.</p></div>
<div class="field"><label for="Alias">Nombre público</label><input class="input" name="Alias" id="Alias" value="@f.Alias" required minlength="2" maxlength="50" /></div>
<fieldset class="opinion-puntuacion"><legend>Tu valoración</legend><div>@for(var i = 1; i <= 5; i++) { <label><input type="radio" name="Estrellas" value="@i" checked="@(f.Estrellas == i)" required /><span>@i ★</span></label> }</div></fieldset>
<div class="field"><label for="Comentario">Cuéntanos tu experiencia</label><textarea class="input" id="Comentario" name="Comentario" rows="5" minlength="10" maxlength="1500" required>@f.Comentario</textarea></div>
<div class="field"><label for="Foto">Foto de tu peinado · opcional</label><input class="input" id="Foto" name="Foto" type="file" accept="image/jpeg,image/png,image/webp" /><p class="field-hint">JPG, PNG o WebP. Hasta 5 MB. Quitaremos los metadatos de la imagen.</p></div>
<label class="check-opcion"><input type="checkbox" name="Consentimiento" value="true" required checked="@f.Consentimiento" /> Autorizo publicar mi opinión y, si la adjunto, mi foto. He evitado datos personales de otras personas.</label></div><button class="btn btn-primary" type="submit">Enviar mi opinión →</button></form></section>
