@model CatalogoIndiceModelo
@{
    ViewData["Title"] = "Catálogo";
}

<div>
    <header class="page-head">
        <div>
            <h1>Catálogo</h1>
            <p class="subtitle">Servicios que ofreces y su precio actual. Cambiar un precio no altera las visitas ya registradas.</p>
        </div>
        <div class="acciones">
            <a class="btn btn-primary" asp-action="Nuevo"><icono nombre="mas" tamano="18" /> Nuevo servicio</a>
        </div>
    </header>

    <form class="toolbar" method="get" asp-action="Index">
        <div class="segmented" role="radiogroup" aria-label="Público">
            <label><input type="radio" name="sexo" value="" checked="@(Model.Sexo is null)" data-enviar-al-cambiar /> Todos</label>
            @foreach (var sexo in new[] { Sexo.Mujer, Sexo.Hombre, Sexo.Otro })
            {
                <label><input type="radio" name="sexo" value="@sexo" checked="@(Model.Sexo == sexo)" data-enviar-al-cambiar /> @Formato.Texto(sexo)</label>
            }
        </div>
    </form>

    @if (Model.Activos.Count == 0 && Model.Archivados.Count == 0)
    {
        <div class="estado-vacio">
            <span class="estado-icono tint-orange"><icono nombre="tijeras" tamano="30" /></span>
            <h2>@(Model.Sexo is null ? "El catálogo está vacío" : "No hay servicios para este público")</h2>
            <p>Añade cortes, tintes y tratamientos con su precio para poder registrarlos en las visitas.</p>
            <div class="acciones"><a class="btn btn-primary" asp-action="Nuevo">Nuevo servicio</a></div>
        </div>
    }
    else
    {
        <div class="catalogo">
            @foreach (var s in Model.Activos)
            {
                <a class="servicio-tarjeta card" asp-action="Editar" asp-route-id="@s.Id">
                    <span class="servicio-foto @Formato.Tinte(s.Sexo)">
                        <icono nombre="tijeras" tamano="34" />
                        @if (s.ImagenRuta is not null)
                        {
                            <img src="@s.ImagenRuta" alt="" loading="lazy" data-ocultar-si-falla />
                        }
                    </span>
                    <span class="servicio-cuerpo">
                        <span class="row-title">@s.Nombre</span>
                        <span class="servicio-pie">
                            <span class="pill @Formato.Tinte(s.Sexo)">@Formato.Texto(s.Sexo)</span>
                            <span class="servicio-precio num">@Formato.Euros(s.Precio)</span>
                        </span>
                    </span>
                </a>
            }
        </div>

        @if (Model.Archivados.Count > 0)
        {
            <section class="section">
                <div class="section-head">
                    <h2>Archivados</h2>
                    <span>No se ofrecen en visitas nuevas</span>
                </div>
                <div class="list">
                    @foreach (var s in Model.Archivados)
                    {
                        <div class="row">
                            <span class="row-main">
                                <a class="row-title" asp-action="Editar" asp-route-id="@s.Id">@s.Nombre</a>
                                <span class="row-sub">@Formato.Texto(s.Sexo) · @Formato.Euros(s.Precio)</span>
                            </span>
                            <form method="post" asp-action="Reactivar" asp-route-id="@s.Id">
                                <button class="btn btn-gray btn-sm"><icono nombre="recuperar" tamano="15" /> Recuperar</button>
                            </form>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>
