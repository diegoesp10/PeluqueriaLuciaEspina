@inject Microsoft.Extensions.Options.IOptionsSnapshot<ContenidoPublico> Publico
@{
    var n = Publico.Value;
    var enServicios = ViewContext.RouteData.Values["action"]?.ToString() == "Servicios";
    var enSalon = ViewContext.RouteData.Values["controller"]?.ToString() == "Inicio" && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183a35" />
    <meta name="color-scheme" content="light dark" />
    <partial name="_TemaInicial" />
    <meta name="description" content="Peluquería ecológica en Oviedo. Coloración vegetal, cortes y tratamientos capilares. Visítanos en Pío XII, 10. Reserva tu cita con Lucía." />
    <title>@ViewData["Title"] · @n.Nombre</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/publico.css" asp-append-version="true" />
</head>
<body class="sitio-publico">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera-publica">
        <a class="marca-publica" asp-area="" asp-controller="Inicio" asp-action="Index" aria-label="Lucía, inicio">
            <img src="~/Img/Icono.jpg" alt="Logo de Lucía" width="64" height="64" />
            <span><strong>Lucía</strong><small>PELUQUERÍA ECOLÓGICA</small></span>
        </a>
        <nav aria-label="Navegación principal">
            <a asp-area="" asp-controller="Inicio" asp-action="Index" aria-current="@(enSalon ? "page" : null)">El salón</a>
            <a asp-area="" asp-controller="Inicio" asp-action="Servicios" aria-current="@(enServicios ? "page" : null)">Servicios</a>
            <a href="@Url.Action("Index", "Inicio", new { area = "" })#contacto">Contacto</a>
            <a class="enlace-admin" asp-area="Admin" asp-controller="Panel" asp-action="Index">Administración <span aria-hidden="true">↗</span></a>
            <a asp-area="" asp-controller="Opiniones" asp-action="Index">Opiniones</a>
        </nav>
        <a class="btn btn-primary" href="@n.Reservas" target="_blank" rel="noopener noreferrer">Reservar cita <span aria-hidden="true">↗</span></a>
    </header>
    <main class="fondo-identidad" id="contenido">@RenderBody()</main>
    <footer class="pie-publico">
        <div class="firma-pie"><img src="~/Img/Icono.jpg" alt="" width="76" height="76" /><div><strong>Lucía</strong><p>Peluquería ecológica · @n.Ciudad</p></div></div>
        <div><a href="@n.TelefonoEnlace">@n.Telefono</a><p>@n.Direccion · @n.CodigoPostal @n.Ciudad</p></div>
        <div><a href="@n.Reservas" target="_blank" rel="noopener noreferrer">Reservar en Booksy ↗</a><p><a asp-area="Admin" asp-controller="Panel" asp-action="Index">Panel de administración ↗</a></p></div>
        <div class="pie-nota"><p>© @DateTime.Now.Year @n.Nombre. Hecho para cuidar de ti.</p><partial name="_SelectorTema" /></div>
    </footer>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @if (ViewData["ControlSesion"] is true) { <partial name="_ControlSesion" /> }
</body>
</html>
