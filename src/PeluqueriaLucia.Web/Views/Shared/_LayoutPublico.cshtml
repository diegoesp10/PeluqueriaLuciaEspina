@inject Microsoft.Extensions.Options.IOptionsSnapshot<ContenidoPublico> Publico
@{
    var n = Publico.Value;
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var enServicios = accion == "Servicios";
    var enSalon = controlador == "Inicio" && accion == "Index";
    var idioma = Idioma.Actual(Context);
    var raiz = Url.Content("~/");
    var absoluta = Context.Request.Scheme + "://" + Context.Request.Host;
    var descripcion = ViewData["Descripcion"] as string
        ?? T["Peluquería ecológica en Oviedo. Coloración vegetal, cortes y tratamientos capilares. El salón está en Pío XII, 10. Solicita tu cita con el equipo del salón."];
    // Textos que necesitan los scripts (avisos de formularios, calendario…)
    var textosJs = new Dictionary<string, string>
    {
        ["contactoError"] = T["No se ha podido verificar el contacto. Puedes completar tus datos manualmente."],
        ["contactoEnviado"] = T["Si el teléfono corresponde a una ficha con correo, recibirás un código en ese correo. También puedes continuar rellenando los datos manualmente."],
        ["contactoCodigo"] = T["Introduce el código de seis dígitos recibido por correo."],
        ["contactoVerificado"] = T["Contacto verificado. Tus datos se han completado; revísalos antes de solicitar la cita."],
        ["sinConexion"] = T["No hay conexión con el salón. Revisa tu conexión a internet y vuelve a intentarlo."],
    };
    // Calendario (fechas.js): la clave es el texto en español
    foreach (var clave in new[] { "Abrir menú", "Cerrar menú", "Elegir fecha", "Año", "Mes", "Periodo anterior", "Periodo siguiente", "Este año", "Este mes", "Hoy", "Seleccionar periodo actual", "Listo", "Cerrar calendario" })
        textosJs[clave] = T[clave];
}
<!DOCTYPE html>
<html lang="@idioma" data-base="@Context.Request.PathBase">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183a35" />
    <meta name="color-scheme" content="light dark" />
    <partial name="_TemaInicial" />
    @* Oculta lo que se va a animar antes de pintar; si el script de movimiento no llega a ejecutarse, todo aparece igual a los 3 s *@
    <script nonce="@SeguridadMiddleware.Nonce(Context)">if(!matchMedia('(prefers-reduced-motion: reduce)').matches){var h=document.documentElement;h.classList.add('anima');setTimeout(function(){if(!window.movimientoListo)h.classList.remove('anima')},3000)}</script>
    <meta name="description" content="@descripcion" />
    <title>@ViewData["Title"] · @n.Nombre</title>
    @if (Context.Request.Path.StartsWithSegments("/admin"))
    {
        @* Las pantallas de acceso al panel usan este diseño, pero no son para los buscadores *@
        <meta name="robots" content="noindex, nofollow" />
    }
    @* Canónica sin parámetros: la misma página con ?pagina=2 o con el idioma en /en es una entrada distinta para el buscador *@
    <link rel="canonical" href="@(absoluta + Context.Request.PathBase + Context.Request.Path)" />
    <meta property="og:url" content="@(absoluta + Context.Request.PathBase + Context.Request.Path)" />
    <link rel="alternate" hreflang="es" href="@(absoluta + Idioma.UrlEn(Context, Idioma.Espanol))" />
    <link rel="alternate" hreflang="en" href="@(absoluta + Idioma.UrlEn(Context, Idioma.Ingles))" />
    <link rel="alternate" hreflang="x-default" href="@(absoluta + Idioma.UrlEn(Context, Idioma.Espanol))" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] · @n.Nombre" />
    <meta property="og:description" content="@descripcion" />
    <meta property="og:locale" content="@(idioma == Idioma.Ingles ? "en_GB" : "es_ES")" />
    <meta property="og:image" content="@(absoluta + Idioma.SinIdioma(Context, "/iconos/icono-512.png"))" />
    <partial name="_Iconos" />
    <link rel="preload" href="~/fonts/source-serif-4/source-serif-4-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/fuentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/lenis/lenis.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/publico.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/movimiento.css" asp-append-version="true" />
</head>
<body class="sitio-publico">
    <a class="saltar" href="#contenido">@T["Saltar al contenido"]</a>
    @* Fondo vivo: hojas y manchas orgánicas que se mueven con el scroll. Decorativo, no recibe clics. *@
    <div class="fondo-vivo" aria-hidden="true">
        <svg class="fondo-hoja fondo-hoja-1" viewBox="0 0 200 320"><path d="M100 8C40 70 18 150 40 222c14 46 42 78 60 90 18-12 46-44 60-90C182 150 160 70 100 8Z" /><path class="nervio" d="M100 30v280M100 110l-34-30M100 150l38-34M100 196l-44-36M100 236l46-38" /></svg>
        <svg class="fondo-hoja fondo-hoja-2" viewBox="0 0 200 320"><path d="M100 8C40 70 18 150 40 222c14 46 42 78 60 90 18-12 46-44 60-90C182 150 160 70 100 8Z" /><path class="nervio" d="M100 30v280M100 110l-34-30M100 150l38-34M100 196l-44-36M100 236l46-38" /></svg>
        <svg class="fondo-hoja fondo-hoja-3" viewBox="0 0 200 320"><path d="M100 8C40 70 18 150 40 222c14 46 42 78 60 90 18-12 46-44 60-90C182 150 160 70 100 8Z" /><path class="nervio" d="M100 30v280M100 110l-34-30M100 150l38-34M100 196l-44-36M100 236l46-38" /></svg>
        <span class="fondo-mancha fondo-mancha-1"></span>
        <span class="fondo-mancha fondo-mancha-2"></span>
        <span class="fondo-mancha fondo-mancha-3"></span>
    </div>
    <header class="cabecera-publica" data-cabecera>
        <a class="marca-publica" asp-area="" asp-controller="Inicio" asp-action="Index" aria-label="@T["Lucía, inicio"]">
            <img src="~/Img/Icono.jpg" alt="@T["Logo de Lucía"]" width="64" height="64" />
            <span><strong>Lucía</strong><small>@T["PELUQUERÍA ECOLÓGICA"]</small></span>
        </a>
        @* En escritorio, enlaces en línea; en móvil, menú lateral que abre el botón hamburguesa (sin JavaScript, por :target) *@
        <nav class="menu-publico" id="menu-publico" data-lenis-prevent aria-label="@T["Navegación principal"]">
            <a class="menu-publico-cerrar" href="#" data-menu-cerrar aria-label="@T["Cerrar menú"]"><icono nombre="cerrar" tamano="20" /></a>
            <p class="menu-publico-titulo" aria-hidden="true">Lucía</p>
            <a asp-area="" asp-controller="Inicio" asp-action="Index" aria-current="@(enSalon ? "page" : null)">@T["El salón"]</a>
            <a asp-area="" asp-controller="Inicio" asp-action="Servicios" aria-current="@(enServicios ? "page" : null)">@T["Servicios"]</a>
            <a asp-area="" asp-controller="Opiniones" asp-action="Index" aria-current="@(controlador == "Opiniones" ? "page" : null)">@T["Opiniones"]</a>
            <a asp-area="" asp-controller="Agenda" asp-action="Index" aria-current="@(controlador == "Agenda" ? "page" : null)">@T["Citas"]</a>
            <a href="@(raiz)#contacto">@T["Contacto"]</a>
            <div class="menu-publico-pie">
                <a class="btn btn-primary btn-block" asp-area="" asp-controller="Agenda" asp-action="Index">@T["Reservar cita"] <icono nombre="flecha-salir" tamano="14" /></a>
                <a class="menu-publico-telefono" href="@n.TelefonoEnlace">@n.Telefono</a>
                <p>@n.Direccion · @n.Ciudad</p>
            </div>
        </nav>
        <a class="menu-fondo" href="#" data-menu-cerrar tabindex="-1" aria-hidden="true"></a>
        <div class="cabecera-acciones">
            <div class="selector-idioma" role="group" aria-label="Idioma · Language">
                <a href="@Idioma.UrlEn(Context, Idioma.Espanol)" hreflang="es" lang="es" aria-current="@(idioma == Idioma.Espanol ? "true" : null)" title="Español">ES</a>
                <a href="@Idioma.UrlEn(Context, Idioma.Ingles)" hreflang="en" lang="en" aria-current="@(idioma == Idioma.Ingles ? "true" : null)" title="English">EN</a>
            </div>
            @* Ruedita de ajustes: apariencia (automática, día o noche) y, en pantallas pequeñas, también el idioma. Sin JavaScript abre y cierra igual (details) *@
            <details class="ajustes-publicos" data-ajustes>
                <summary class="ajustes-boton" title="@T["Ajustes"]"><icono nombre="ajustes" tamano="20" /><span class="sr-only">@T["Ajustes"]</span></summary>
                <div class="ajustes-panel glass" role="group" aria-label="@T["Ajustes"]">
                    <div class="ajustes-fila ajustes-idioma">
                        <span>@T["Idioma"]</span>
                        <div class="selector-idioma" role="group" aria-label="Idioma · Language">
                            <a href="@Idioma.UrlEn(Context, Idioma.Espanol)" hreflang="es" lang="es" aria-current="@(idioma == Idioma.Espanol ? "true" : null)">ES</a>
                            <a href="@Idioma.UrlEn(Context, Idioma.Ingles)" hreflang="en" lang="en" aria-current="@(idioma == Idioma.Ingles ? "true" : null)">EN</a>
                        </div>
                    </div>
                    <div class="ajustes-fila">
                        <span>@T["Apariencia"]</span>
                        <partial name="_SelectorTema" />
                    </div>
                </div>
            </details>
            <a class="btn btn-primary cabecera-reservar" asp-area="" asp-controller="Agenda" asp-action="Index" data-magnetico>@T["Reservar cita"] <icono nombre="flecha-salir" tamano="14" /></a>
            <a class="boton-menu" href="#menu-publico" aria-controls="menu-publico" aria-expanded="false" data-menu-abrir>
                <icono nombre="menu" tamano="22" /><span class="sr-only">@T["Abrir menú"]</span>
            </a>
        </div>
    </header>
    <main class="fondo-identidad" id="contenido">@RenderBody()</main>
    <footer class="pie-publico">
        <div class="firma-pie"><img src="~/Img/Icono.jpg" alt="" width="76" height="76" /><div><strong>Lucía</strong><p>@T["Peluquería ecológica"] · @n.Ciudad</p></div></div>
        <div><a href="@n.TelefonoEnlace">@n.Telefono</a><p>@n.Direccion · @n.CodigoPostal @n.Ciudad</p></div>
        <div><a asp-area="" asp-controller="Agenda" asp-action="Index">@T["Reservar cita"] <icono nombre="flecha-salir" tamano="14" /></a><p><a href="@Idioma.SinIdioma(Context, "/admin")" hreflang="es">@T["Panel de administración"] <icono nombre="flecha-salir" tamano="14" /></a></p></div>
        <div class="pie-nota">
            <nav class="pie-legal" aria-label="@T["Información legal"]">
                <a asp-area="" asp-controller="Legal" asp-action="Privacidad">@T["Política de privacidad"]</a>
                <a asp-area="" asp-controller="Legal" asp-action="Terminos">@T["Términos y condiciones"]</a>
            </nav>
            <p>© @DateTime.Now.Year @n.Nombre. @T["Hecho para cuidar de ti."]</p>
        </div>
    </footer>
    <script type="application/json" id="textos-js">@Json.Serialize(textosJs)</script>
    <script src="~/js/cargando.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/fechas.js" asp-append-version="true"></script>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/SplitText.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/lenis/lenis.min.js" asp-append-version="true" defer></script>
    <script src="~/js/movimiento.js" asp-append-version="true" defer></script>
    @if (ViewData["ControlSesion"] is true) { <partial name="_ControlSesion" /> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
