@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) && accion != "Nueva" ? "is-active" : "";
    var enNuevaVisita = controlador == "Visitas" && accion == "Nueva";
    var exito = TempData[Avisos.ClaveExito] as string;
    var error = TempData[Avisos.ClaveError] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    @* Aplica el tema elegido antes de pintar nada, para que la página no parpadee al cargar *@
    <script>try{var t=localStorage.getItem('tema');if(t==='dia'||t==='noche')document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>@ViewData["Title"] · Peluquería Lucía</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
    @* Precarga la página de un enlace al pasar el ratón por encima: al hacer clic se abre al instante *@
    <script type="speculationrules">
        { "prefetch": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/Visitas/Exportar*" } }] }, "eagerness": "moderate" }] }
    </script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div class="app">
        <aside class="sidebar glass" aria-label="Navegación principal">
            <a class="brand" asp-controller="Visitas" asp-action="Index">
                <img class="brand-logo" src="~/Img/Icono.jpg" alt="" width="40" height="40" />
                <span class="brand-text">
                    <strong>Lucía</strong>
                    <small>Peluquería ecológica</small>
                </span>
            </a>

            <a class="btn btn-primary btn-block @(enNuevaVisita ? "is-current" : "")" asp-controller="Visitas" asp-action="Nueva" title="Nueva visita">
                <icono nombre="mas" tamano="18" /> Nueva visita
            </a>

            <nav class="nav">
                <a class="nav-item tint-blue @Activo("Visitas")" asp-controller="Visitas" asp-action="Index" title="Visitas">
                    <span class="nav-tile"><icono nombre="calendario" tamano="17" /></span> Visitas
                </a>
                <a class="nav-item tint-green @Activo("Clientes")" asp-controller="Clientes" asp-action="Index" title="Clientes">
                    <span class="nav-tile"><icono nombre="clientes" tamano="17" /></span> Clientes
                </a>
                <a class="nav-item tint-orange @Activo("Catalogo")" asp-controller="Catalogo" asp-action="Index" title="Catálogo">
                    <span class="nav-tile"><icono nombre="tijeras" tamano="17" /></span> Catálogo
                </a>
            </nav>

            <div class="sidebar-foot">
                <partial name="_SelectorTema" />
                <p>© @DateTime.Now.Year Peluquería Ecológica Lucía Espina</p>
            </div>
        </aside>

        <header class="topbar glass">
            <a class="brand" asp-controller="Visitas" asp-action="Index">
                <img class="brand-logo" src="~/Img/Icono.jpg" alt="" width="32" height="32" />
                <span class="brand-text"><strong>Lucía</strong></span>
            </a>
            <partial name="_SelectorTema" />
        </header>

        <main class="main" id="contenido" tabindex="-1">
            @RenderBody()
        </main>

        <nav class="tabbar glass" aria-label="Navegación principal">
            <a class="tab @Activo("Visitas")" asp-controller="Visitas" asp-action="Index"><icono nombre="calendario" /><span>Visitas</span></a>
            <a class="tab tab-accent @(enNuevaVisita ? "is-active" : "")" asp-controller="Visitas" asp-action="Nueva"><icono nombre="mas" /><span>Nueva</span></a>
            <a class="tab @Activo("Clientes")" asp-controller="Clientes" asp-action="Index"><icono nombre="clientes" /><span>Clientes</span></a>
            <a class="tab @Activo("Catalogo")" asp-controller="Catalogo" asp-action="Index"><icono nombre="tijeras" /><span>Catálogo</span></a>
        </nav>
    </div>

    <div class="toasts" aria-live="polite">
        @if (exito is not null)
        {
            <div class="toast glass tint-green" role="status">
                <span class="toast-icon"><icono nombre="check-circulo" /></span>
                <span>@exito</span>
                <button type="button" class="toast-close" data-cerrar-toast aria-label="Cerrar"><icono nombre="cerrar" tamano="16" /></button>
            </div>
        }
        @if (error is not null)
        {
            <div class="toast glass tint-red" role="alert" data-persistente>
                <span class="toast-icon"><icono nombre="alerta" /></span>
                <span>@error</span>
                <button type="button" class="toast-close" data-cerrar-toast aria-label="Cerrar"><icono nombre="cerrar" tamano="16" /></button>
            </div>
        }
    </div>

    <dialog class="alerta" id="dialogo-confirmar" aria-labelledby="dialogo-titulo">
        @* Formulario solo del navegador (cierra el diálogo): sin token, que marcaría todas las páginas como no cacheables *@
        <form method="dialog" asp-antiforgery="false">
            <h2 id="dialogo-titulo">¿Seguro?</h2>
            <p id="dialogo-texto"></p>
            <div class="alerta-botones">
                <button class="alerta-boton" value="cancelar" autofocus>Cancelar</button>
                <button class="alerta-boton is-destructive" value="confirmar" id="dialogo-aceptar">Eliminar</button>
            </div>
        </form>
    </dialog>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
