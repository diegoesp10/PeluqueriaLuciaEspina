@* Apariencia: automática (la del sistema), día o noche. La elección se guarda en este navegador (ver app.js) *@
<div class="selector-tema" role="radiogroup" aria-label="Apariencia" data-selector-tema>
    <button type="button" role="radio" aria-checked="true" data-tema="auto" title="Automática: como el sistema">
        <icono nombre="auto" tamano="16" /><span class="sr-only">Automática</span>
    </button>
    <button type="button" role="radio" aria-checked="false" data-tema="dia" title="Día">
        <icono nombre="sol" tamano="16" /><span class="sr-only">Día</span>
    </button>
    <button type="button" role="radio" aria-checked="false" data-tema="noche" title="Noche">
        <icono nombre="luna" tamano="16" /><span class="sr-only">Noche</span>
    </button>
</div>
