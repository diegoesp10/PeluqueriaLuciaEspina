@model ContenidoPublico
@{ ViewData["Title"] = "Tu cabello, en buenas manos"; }
<section class="hero-publico">
    <div class="hero-texto">
        <p class="etiqueta"><span aria-hidden="true">✳</span> BELLEZA CON RAÍCES · OVIEDO</p>
        <h1>Tu cabello.<br />Tu esencia.<br /><em>Al natural.</em></h1>
        <p class="intro">Un espacio para ti y para el cuidado de tu cabello. Descubre la peluquería ecológica de Lucía, en el corazón de Oviedo.</p>
        <div class="botones"><a class="btn btn-primary" href="/citas">Encuentra tu momento <span aria-hidden="true">↗</span></a><a class="enlace-flecha" asp-action="Servicios">Nuestros servicios →</a></div>
        <p class="detalle-hero">COLORACIÓN VEGETAL <span>·</span> CUIDADO CAPILAR <span>·</span> TRATO CERCANO</p>
    </div>
    <div class="hero-foto">
        <img src="~/publico/salon.jpg" asp-append-version="true" alt="Interior del salón Lucía Peluquería Ecológica en Oviedo" width="640" height="427" fetchpriority="high" />
        <img class="hero-emblema" src="~/Img/Icono.jpg" alt="" width="120" height="120" />
        <div class="foto-sello"><span>Un pequeño refugio</span><strong>para sentirte tú.</strong></div>
    </div>
</section>
<div class="franja-publica"><span>Color de origen vegetal</span><span aria-hidden="true">✳</span><span>Cuidado y bienestar capilar</span><span aria-hidden="true">✳</span><span>Tu estilo, a tu ritmo</span></div>
<section class="seccion-publica filosofia">
    <div><p class="etiqueta">01 / NUESTRA ESENCIA</p><h2>El cuidado empieza<br /><em>en la raíz.</em></h2></div>
    <div><p class="texto-grande">Cada cabello tiene su historia. Nos gusta escuchar la tuya.</p><p>Con Lucía puedes descubrir cortes, coloración ecológica y tratamientos para cuidar tu cabello. Un salón cercano donde encontrar tu estilo y dedicarte un momento.</p><a class="enlace-flecha" href="@Model.TelefonoEnlace">Hablemos de tu cabello →</a></div>
</section>
<section class="seccion-publica servicios-destacados">
    <div class="titulo-seccion"><div><p class="etiqueta">02 / LO QUE HACEMOS</p><h2>Naturalmente,<br /><em>para ti.</em></h2></div><a class="enlace-flecha" asp-action="Servicios">Ver todos los servicios →</a></div>
    <div class="especialidades">
        <a asp-action="Servicios" asp-fragment="peluqueria"><span class="numero">01</span><span class="simbolo" aria-hidden="true">✳</span><h3>Color & naturaleza</h3><p>Tinte ecológico y coloración 100 % plantas. Encuentra el color que habla de ti.</p><span class="enlace-flecha">Descubrir →</span></a>
        <a asp-action="Servicios" asp-fragment="tratamientos"><span class="numero">02</span><span class="simbolo" aria-hidden="true">◌</span><h3>Un respiro para tu pelo</h3><p>Oxigenación, hidratación y tratamientos de regeneración para el cuidado capilar.</p><span class="enlace-flecha">Descubrir →</span></a>
        <a asp-action="Servicios" asp-fragment="peluqueria"><span class="numero">03</span><span class="simbolo" aria-hidden="true">✂</span><h3>Tu estilo, tu forma</h3><p>Cortes, rizos en seco, peinados y recogidos. Para el día a día y tus momentos especiales.</p><span class="enlace-flecha">Descubrir →</span></a>
    </div>
</section>
<section class="cita-publica"><p class="etiqueta">UN MOMENTO PARA CUIDARTE</p><h2>Ven como eres.<br /><em>Sal sintiéndote tú.</em></h2><a class="btn btn-light" href="/citas">Reserva tu próxima cita ↗</a></section>
<section class="seccion-publica contacto-publico" id="contacto">
    <div><p class="etiqueta">03 / NOS VEMOS EN OVIEDO</p><h2>Muy cerca.<br /><em>Muy tuyo.</em></h2><p>Te esperamos en @Model.Direccion,<br />@Model.CodigoPostal @Model.Ciudad.</p><a class="enlace-flecha" href="@Model.Mapa" target="_blank" rel="noopener noreferrer">Cómo llegar →</a></div>
    <div class="contacto-tarjeta"><p class="etiqueta">HABLEMOS</p><a class="telefono-grande" href="@Model.TelefonoEnlace">@Model.Telefono</a><p>Llámanos para consultar un servicio o preparar tu visita.</p><a class="btn btn-primary" href="/citas">Solicitar mi cita →</a><p class="nota">Elige día y hora. Lucía validará tu solicitud por teléfono.</p><div class="comodidades">@foreach (var comodidad in Model.Comodidades) { <span>@comodidad</span> }</div></div>
</section>
