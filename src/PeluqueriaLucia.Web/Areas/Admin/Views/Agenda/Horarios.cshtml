@model PeluqueriaLucia.Web.Models.HorariosPagina
@{ViewData["Title"]="Horarios de la agenda";var dias=new[]{"Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"};}
<header class="page-head"><div><h1>Horarios y descansos</h1><p class="subtitle">Una agenda para una profesional. Los huecos públicos se calculan con estos tramos.</p></div><a class="btn btn-gray" href="/admin/agenda">Volver a la agenda</a></header>
<div class="agenda-horarios">
<section class="card"><h2>Horario semanal</h2><p>Los cambios de horario no cancelan las citas ya confirmadas.</p>@foreach(var t in Model.Horarios){<div class="agenda-tramo agenda-tramo-editable"><form method="post" action="/admin/agenda/horarios">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="dia" value="@((int)t.Dia)" /><h3>@dias[(int)t.Dia]</h3><div class="agenda-gestion"><label>Desde<input type="time" name="desde" value="@t.Desde.ToString("HH:mm")" required /></label><label>Hasta<input type="time" name="hasta" value="@t.Hasta.ToString("HH:mm")" required /></label></div><label>Ofrecer una hora cada (minutos)<input type="number" name="intervaloMinutos" value="@t.IntervaloMinutos" min="1" max="600" step="1" required /></label><button class="btn btn-gray">Guardar cambios</button></form><form method="post" action="/admin/agenda/eliminar-horario">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><button class="btn btn-gray btn-destructive">Eliminar tramo</button></form></div>}
<form method="post" action="/admin/agenda/horarios">@Html.AntiForgeryToken()<h3>Añadir tramo</h3><label>Día<select name="dia">@for(var i=0;i<7;i++){<option value="@i">@dias[i]</option>}</select></label><div class="agenda-gestion"><label>Desde<input type="time" name="desde" required /></label><label>Hasta<input type="time" name="hasta" required /></label></div><label>Ofrecer una hora cada (minutos)<input type="number" name="intervaloMinutos" value="15" min="1" max="600" step="1" required /></label><p class="nota">El intervalo fija las horas de inicio. La duración del servicio bloquea todo el tiempo necesario, aunque abarque varios intervalos.</p><button class="btn btn-primary">Guardar horario</button></form></section>
<section class="card"><h2>Vacaciones y días cerrados</h2>@foreach(var c in Model.Cierres){<div class="agenda-tramo"><strong>@c.Dia.ToString("dd/MM/yyyy")</strong><span>@c.Motivo</span><form method="post" action="/admin/agenda/abrir-dia">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="btn btn-gray">Reabrir</button></form></div>}
<form method="post" action="/admin/agenda/cerrar-dia">@Html.AntiForgeryToken()<label>Día<input type="date" name="dia" min="@Model.Hoy.ToString("yyyy-MM-dd")" required /></label><label>Motivo interno<input name="motivo" maxlength="100" placeholder="Vacaciones, festivo…" /></label><button class="btn btn-primary">Cerrar este día</button></form><p>Si ya hay reservas, primero cancélalas o recházalas y avisa a sus clientes.</p></section>
</div>
