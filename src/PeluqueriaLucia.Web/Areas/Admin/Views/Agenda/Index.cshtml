@model PeluqueriaLucia.Web.Models.AgendaCalendario
@using PeluqueriaLucia.Domain.Agenda
@using PeluqueriaLucia.Web.Models
@section Scripts {
    <script src="~/js/agenda-navegacion.js" asp-append-version="true"></script>
}
@{
    ViewData["Title"] = "Agenda de citas";
    var dia = Model.Dia.ToString("yyyy-MM-dd");
    string Ruta(DateOnly d, FiltroCitas? filtro = null) => $"/admin/agenda?dia={d:yyyy-MM-dd}&estado={filtro ?? Model.Filtro}";
    var nuevos = ViewData["ClientesPendientes"] as IReadOnlyList<PeluqueriaLucia.Domain.Clientes.Cliente> ?? [];
    var candidatos = ViewData["CandidatosClientes"] as Dictionary<Guid,List<PeluqueriaLucia.Domain.Clientes.Cliente>> ?? [];
    var conflictos = ViewData["ConflictosClientes"] as IReadOnlyList<ReservaCita> ?? [];
    var filtros = new[] { (FiltroCitas.Abiertas, "Abiertas"), (FiltroCitas.Canceladas, "Canceladas"), (FiltroCitas.Completadas, "Completadas"), (FiltroCitas.Todas, "Todas") };
}
<header class="page-head">
    <div><p class="etiqueta">ESPACIO PROFESIONAL</p><h1>Agenda de citas</h1><p class="subtitle">Cada día del mes con lo que tiene agendado. Pulsa un día para ver y gestionar sus citas.</p></div>
    <div class="agenda-botones"><a class="btn btn-primary" href="/admin/agenda/nueva?dia=@dia">Nueva cita</a><a class="btn btn-gray" href="/admin/agenda/nueva?dia=@dia&amp;bloqueo=true">Bloquear tiempo</a><a class="btn btn-gray" href="/admin/agenda/horarios">Horarios y días de cierre</a><a class="btn btn-gray" href="/admin/comunicaciones">Comunicaciones</a></div>
</header>

@if (nuevos.Count > 0) { <section class="agenda-avisos"><h2>@nuevos.Count fichas pendientes de completar</h2><p>Clientes creados al aceptar su cita. Completa sus datos antes de registrar la visita.</p><div class="agenda-botones">@foreach (var cliente in nuevos) { <a class="btn btn-gray" href="/admin/clientes/Detalle/@cliente.Id">@cliente.NombreCompleto · Completar ficha</a> }</div></section> }
@if (conflictos.Count > 0) { <section class="agenda-avisos"><h2>Contactos que necesitan revisión</h2><p>Una coincidencia parcial no permite identificar automáticamente al cliente. Revisa las fichas en Clientes y verifica personalmente el teléfono y el correo antes de vincular.</p>
@foreach (var reserva in conflictos) { <article class="card"><h3>@reserva.Nombre</h3><p>@reserva.Telefono · @reserva.Correo · @reserva.Inicio.ToString("dd/MM/yyyy HH:mm")</p><form method="post" action="/admin/agenda/vincular-cliente">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reserva.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(reserva.Version)" /><div class="agenda-gestion"><label>Ficha<select name="clienteId" required>@foreach (var c in candidatos.GetValueOrDefault(reserva.Id, [])) { <option value="@c.Id">@c.NombreCompleto · @c.Telefono · @c.Email</option> }</select></label></div><label class="agenda-consentimiento"><input type="checkbox" name="contactoVerificado" value="true" /> He verificado personalmente el teléfono y el correo con el cliente.</label><div class="agenda-botones"><button class="btn btn-primary">Vincular a esta ficha</button></div></form></article> }
</section> }

<div class="calendario-panel">
    <section class="card calendario-tarjeta" aria-label="Calendario del mes">
        <div class="calendario-mes">
            <a class="btn btn-gray" href="@Ruta(Model.MesAnterior)" aria-label="Mes anterior"><icono nombre="anterior" tamano="18" /></a>
            <h2>@Model.InicioMes.ToString("MMMM yyyy")</h2>
            <div class="agenda-botones"><a class="btn btn-gray" href="@Ruta(Model.Hoy)">Hoy</a><a class="btn btn-gray" href="@Ruta(Model.MesSiguiente)" aria-label="Mes siguiente"><icono nombre="siguiente" tamano="18" /></a></div>
        </div>
        <div class="calendario-grid">
            @foreach (var nombre in new[] { "L", "M", "X", "J", "V", "S", "D" }) { <span class="calendario-semana" aria-hidden="true">@nombre</span> }
            @for (var i = 0; i < Model.Desplazamiento; i++) { <span class="calendario-dia vacio"></span> }
            @foreach (var d in Model.Dias)
            {
                var clases = "calendario-dia" + (d.Dia == Model.Hoy ? " hoy" : "") + (d.Dia == Model.Dia ? " elegido" : "") + (d.Dia < Model.Hoy ? " pasado" : "") + (d.Cierre is not null ? " cerrado" : "");
                <a class="@clases" href="@Ruta(d.Dia)" aria-current="@(d.Dia == Model.Dia ? "date" : null)" aria-label="@d.Dia.ToString("dddd d 'de' MMMM")@(d.Total > 0 ? $", {d.Total} en agenda" : "")@(d.Cierre is not null ? ", cerrado" : "")">
                    <span class="calendario-numero">@d.Dia.Day</span>
                    <span class="calendario-puntos">
                        @if (d.Abiertas > 0) { <span class="calendario-punto abiertas" title="Abiertas">@d.Abiertas</span> }
                        @if (d.Completadas > 0) { <span class="calendario-punto completadas" title="Completadas">@d.Completadas</span> }
                        @if (d.Canceladas > 0) { <span class="calendario-punto canceladas" title="Canceladas">@d.Canceladas</span> }
                        @if (d.Bloqueos > 0) { <span class="calendario-punto bloqueos" title="Bloqueos">@d.Bloqueos</span> }
                        @if (d.Cierre is not null) { <span class="calendario-cierre">@(string.IsNullOrEmpty(d.Cierre) ? "Cerrado" : d.Cierre)</span> }
                    </span>
                </a>
            }
        </div>
        <div class="calendario-pie">
            <div class="calendario-leyenda"><span><i class="calendario-punto abiertas"></i> Abiertas</span><span><i class="calendario-punto completadas"></i> Completadas</span><span><i class="calendario-punto canceladas"></i> Canceladas</span><span><i class="calendario-punto bloqueos"></i> Bloqueos</span></div>
            <p class="nota">@Model.Avisos.Pendientes @(Model.Avisos.Pendientes == 1 ? "solicitud pendiente" : "solicitudes pendientes") de la web en total.</p>
        </div>
    </section>

    <section class="calendario-dia-panel" aria-label="Citas del día elegido">
        <h2>@Model.Dia.ToString("dddd d 'de' MMMM")</h2>
        <p class="subtitle">@(Model.CitasDia.Count == 0 ? "Sin citas con este filtro." : $"{Model.CitasDia.Count} en agenda.")</p>
        <nav class="segmentos" aria-label="Filtrar por estado">
            @foreach (var (filtro, texto) in filtros) { <a class="segmento @(filtro == Model.Filtro ? "activo" : "")" href="@Ruta(Model.Dia, filtro)" aria-current="@(filtro == Model.Filtro ? "page" : null)">@texto</a> }
        </nav>
        @foreach (var c in Model.CitasDia)
        {
            var caducada = AgendaCalendario.Caducada(c, Model.Utc);
            var web = c.Origen == OrigenCita.Web; var bloqueo = c.Origen == OrigenCita.Bloqueo;
            var cerrada = AgendaCalendario.GrupoDe(c, Model.Utc) == FiltroCitas.Canceladas;
            // La cita confirmada ya es su visita: se completa al cobrarla
            var visita = AgendaCalendario.Cobrable(c) ? Model.VisitaDe(c) : null;
            var estado = visita is { EstaCobrada: true } && c.Estado == EstadoCita.Completada ? "Completada y cobrada" : AgendaCalendario.TextoEstado(c, Model.Utc);
            <article class="card agenda-cita@(bloqueo ? " agenda-bloqueo" : "")"><div class="agenda-cita-hora"><strong>@c.Inicio.ToString("HH:mm")</strong><span>hasta @c.Fin.ToString("HH:mm")</span><span class="badge">@estado</span>@if (c.Origen == OrigenCita.Panel) { <span class="badge">Dada en el salón</span> }@if (c.Dualidad) { <span class="badge" title="Servicio con dualidad: puede coincidir con otras citas">Dualidad</span> }</div><div class="agenda-cita-datos">
            @if (bloqueo) { <h3>@c.Nombre</h3> }
            else
            {
                <h3>@(string.IsNullOrEmpty(c.Nombre) ? "Solicitud de cita" : (c.Nombre + " " + c.Apellido).Trim())</h3><p>@c.ServicioNombre</p>
                @if (!string.IsNullOrEmpty(c.Telefono)) { <a class="agenda-telefono" href="tel:@c.Telefono">@c.Telefono <icono nombre="flecha-salir" tamano="14" /></a> }
                @if (web) { <p>@c.Correo · @c.Canal</p> }
                @if (c.AceptadaUtc is not null) { <p class="nota">Aceptada por el cliente.</p> }
            }
            @if (AgendaCalendario.Cobrable(c) || c.Cliente is not null)
            {
                <div class="agenda-botones">
                    @if (AgendaCalendario.Cobrable(c))
                    {
                        @* «Completar y cobrar» abre (o crea) la visita de la cita y lleva a ella; la cita queda completada al cobrarla *@
                        if (visita is { EstaCobrada: true }) { <a class="btn btn-gray" href="/admin/Visitas/Ticket/@visita.Id"><icono nombre="check" tamano="16" /> Cobrada · @Formato.Euros(visita.Total)</a> }
                        else if (visita is not null) { <a class="btn btn-success" href="/admin/Visitas/Detalle/@visita.Id"><icono nombre="euro" tamano="16" /> Cobrar · @Formato.Euros(visita.Total)</a> }
                        else { <form method="post" action="/admin/Visitas/DesdeCita">@Html.AntiForgeryToken()<input type="hidden" name="reservaId" value="@c.Id" /><input type="hidden" name="volver" value="@Ruta(Model.Dia)" /><button class="btn btn-success"><icono nombre="euro" tamano="16" /> @(c.Estado == EstadoCita.Completada ? "Cobrar" : "Completar y cobrar")</button></form> }
                    }
                    @if (c.Cliente is not null) { <a class="btn btn-gray" href="/admin/clientes/Detalle/@c.ClienteId">Ficha de cliente · @c.Cliente.NumeroFaltas faltas</a>@if (c.Cliente.PendienteCompletar) { <span class="badge">Ficha incompleta</span> } }
                </div>
            }
            @if (c.Estado == EstadoCita.Confirmada && c.ClienteId is not null) { <form method="post" action="/admin/agenda/falta">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)" /><div class="agenda-gestion"><label>Nota sobre la inasistencia (solo administración)<input name="nota" maxlength="500" /></label></div><div class="agenda-botones"><button class="btn btn-gray">Registrar falta de asistencia</button></div></form> }
            @if (c.Estado is EstadoCita.Pendiente or EstadoCita.Confirmada or EstadoCita.PendienteAceptacion && !caducada)
            {
                <form method="post" action="/admin/agenda/gestionar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)" /><input type="hidden" name="dia" value="@dia" />
                    <div class="agenda-gestion"><label>Duración (min)<input type="number" name="minutos" min="5" max="600" step="1" value="@((int)(c.Fin - c.Inicio).TotalMinutes)" required /></label><label>Nota interna<input name="nota" maxlength="500" value="@c.NotaInterna" /></label></div>
                    @if (web)
                    {
                        <label class="agenda-consentimiento"><input type="checkbox" name="telefonoValidado" value="true" checked="@c.TelefonoValidado" /> He contactado con este teléfono y validado la cita.</label><div class="agenda-botones"><button class="btn btn-primary" name="estado" value="Confirmada">@(c.Estado == EstadoCita.Confirmada ? "Actualizar duración" : c.Estado == EstadoCita.PendienteAceptacion ? "Guardar ajustes" : "Preparar propuesta")</button>@if (c.Estado != EstadoCita.Confirmada) { <button class="btn btn-gray" name="estado" value="Confirmada" formaction="/admin/agenda/gestionar?confirmarDirecto=true" title="Ya la has acordado con el cliente: queda confirmada sin esperar a que acepte el enlace.">Confirmar ya (acordada por teléfono)</button> }<button class="btn btn-gray" name="estado" value="@(c.Estado == EstadoCita.Pendiente ? "Rechazada" : "Cancelada")">@(c.Estado == EstadoCita.Pendiente ? "Rechazar" : "Cancelar cita")</button></div>
                    }
                    else
                    {
                        <input type="hidden" name="telefonoValidado" value="true" /><div class="agenda-botones"><button class="btn btn-primary" name="estado" value="Confirmada">Guardar cambios</button><button class="btn btn-gray" name="estado" value="Cancelada">@(bloqueo ? "Quitar bloqueo" : "Cancelar cita")</button></div>
                    }
                </form>
            }
            else if (!string.IsNullOrEmpty(c.NotaInterna)) { <p>@c.NotaInterna</p> }
            @if (cerrada)
            {
                <form class="cita-eliminar" method="post" action="/admin/agenda/eliminar" data-confirmar="La cita de @c.Inicio.ToString("HH:mm") se eliminará de la agenda con sus avisos. No se puede deshacer.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="dia" value="@dia" /><input type="hidden" name="estado" value="@Model.Filtro" /><button class="btn btn-gray btn-destructive">Eliminar de la agenda</button></form>
            }
            </div></article>
        }
    </section>
</div>

@if (Model.Pendientes.Count > 0)
{
    <section class="agenda-jornada" id="pendientes">
        <h2>Solicitudes pendientes de otros días</h2>
        <div class="agenda-botones">@foreach (var c in Model.Pendientes) { <a class="btn btn-gray" href="@Ruta(DateOnly.FromDateTime(c.Inicio), FiltroCitas.Abiertas)">@c.Inicio.ToString("d MMM HH:mm") · @(string.IsNullOrEmpty(c.Nombre) ? "Solicitud" : c.Nombre) · @AgendaCalendario.TextoEstado(c, Model.Utc)</a> }</div>
    </section>
}
