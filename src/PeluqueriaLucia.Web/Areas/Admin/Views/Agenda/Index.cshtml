@model PeluqueriaLucia.Web.Models.AgendaPanel
@using PeluqueriaLucia.Domain.Agenda
@{ViewData["Title"]="Agenda de citas";}
<header class="page-head"><div><p class="etiqueta">ESPACIO PROFESIONAL</p><h1>Agenda de citas</h1><p class="subtitle">Solicitudes, tiempos de cuidado y conversaciones con tus clientes.</p></div><a class="btn btn-gray" href="/admin/agenda/horarios">Horarios y días de cierre</a></header>
<div class="agenda-avisos" role="status"><strong>@Model.Avisos.Pendientes solicitudes pendientes</strong><p>Se muestran las citas de la semana y todas las solicitudes pendientes, aunque sean de otra semana. Valida el teléfono, prepara la propuesta y espera a que el cliente la acepte.</p></div>
@{
    var nuevos = ViewData["ClientesPendientes"] as IReadOnlyList<PeluqueriaLucia.Domain.Clientes.Cliente> ?? [];
    var candidatos = ViewData["CandidatosClientes"] as Dictionary<Guid,List<PeluqueriaLucia.Domain.Clientes.Cliente>> ?? [];
    var conflictos = ViewData["ConflictosClientes"] as IReadOnlyList<ReservaCita> ?? [];
}
@if(nuevos.Count > 0){<section class="agenda-avisos"><h2>@nuevos.Count fichas pendientes de completar</h2><p>Clientes creados al aceptar su cita. Completa sus datos antes de registrar la visita.</p><div class="agenda-botones">@foreach(var cliente in nuevos){<a class="btn btn-gray" href="/admin/clientes/Detalle/@cliente.Id">@cliente.NombreCompleto · Completar ficha</a>}</div></section>}
@if(conflictos.Count > 0){<section class="agenda-avisos"><h2>Contactos que necesitan revisión</h2><p>Una coincidencia parcial no permite identificar automáticamente al cliente. Revisa las fichas en Clientes y verifica personalmente el teléfono y el correo antes de vincular.</p>
@foreach(var reserva in conflictos){<article class="card"><h3>@reserva.Nombre</h3><p>@reserva.Telefono · @reserva.Correo · @reserva.Inicio.ToString("dd/MM/yyyy HH:mm")</p><form method="post" action="/admin/agenda/vincular-cliente">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@reserva.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(reserva.Version)" /><div class="agenda-gestion"><label>Ficha revisada<select name="clienteId" required><option value="">Selecciona tras verificar el contacto</option>@foreach(var candidato in candidatos[reserva.Id]){<option value="@candidato.Id">@candidato.NombreCompleto · #@candidato.Id · @candidato.Telefono · @candidato.Email</option>}</select></label></div><label class="agenda-consentimiento"><input type="checkbox" name="contactoVerificado" value="true" required /> He comprobado que ambos contactos pertenecen a esta persona.</label><div class="agenda-botones"><a class="btn btn-gray" href="/admin/clientes">Revisar clientes</a><button class="btn btn-primary">Vincular ficha</button></div></form></article>}
</section>}
<form method="get" class="agenda-filtro"><label for="agenda-fecha">Semana desde</label><input id="agenda-fecha" type="date" name="dia" value="@Model.Dia.ToString("yyyy-MM-dd")" /><button class="btn btn-gray">Buscar</button><a class="btn btn-gray" href="/admin/agenda?dia=@Model.Dia.AddDays(7).ToString("yyyy-MM-dd")">Semana siguiente →</a></form>
<div class="agenda-lista">
@foreach(var grupo in Model.Citas.GroupBy(x=>DateOnly.FromDateTime(x.Inicio))){
    <section class="agenda-jornada"><h2>@grupo.Key.ToString("dddd d 'de' MMMM")</h2>
    @foreach(var c in grupo){var caducada=(c.Estado is EstadoCita.Pendiente or EstadoCita.PendienteAceptacion)&&c.CaducaUtc<=DateTime.UtcNow;
        <article class="card agenda-cita"><div class="agenda-cita-hora"><strong>@c.Inicio.ToString("HH:mm")</strong><span>hasta @c.Fin.ToString("HH:mm")</span><span class="badge">@(caducada?"Caducada":c.Estado==EstadoCita.PendienteAceptacion?"Pendiente de aceptación":c.Estado.ToString())</span></div><div class="agenda-cita-datos"><h3>@(string.IsNullOrEmpty(c.Nombre)?"Solicitud de cita":c.Nombre)</h3><p>@c.ServicioNombre</p><a class="agenda-telefono" href="tel:@c.Telefono">@c.Telefono ↗</a><p>@c.Correo · @c.Canal</p>@if(c.AceptadaUtc is not null){<p class="nota">Aceptada por el cliente.</p>}
        @if(c.Cliente is not null){<div class="agenda-botones"><a class="btn btn-gray" href="/admin/clientes/Detalle/@c.ClienteId">Ficha de cliente · @c.Cliente.NumeroFaltas faltas</a>@if(c.Cliente.PendienteCompletar){<span class="badge">Ficha pendiente de completar</span>}</div>}
        @if(c.Estado == EstadoCita.Confirmada && c.ClienteId is not null){<form method="post" action="/admin/agenda/falta">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)" /><div class="agenda-gestion"><label>Nota sobre la inasistencia (solo administración)<input name="nota" maxlength="500" /></label></div><div class="agenda-botones"><button class="btn btn-gray btn-destructive">Registrar que no acudió</button></div><p class="nota">Disponible cuando termine el horario reservado. Se registra en su ficha y no se comunica al cliente.</p></form>}
        @if(c.Estado is EstadoCita.Pendiente or EstadoCita.Confirmada or EstadoCita.PendienteAceptacion && !caducada){
            <form method="post" action="/admin/agenda/gestionar">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><input type="hidden" name="version" value="@Convert.ToBase64String(c.Version)" /><input type="hidden" name="dia" value="@Model.Dia.ToString("yyyy-MM-dd")" />
                <div class="agenda-gestion"><label>Duración (min)<input type="number" name="minutos" min="5" max="600" step="1" value="@((int)(c.Fin-c.Inicio).TotalMinutes)" required /></label><label>Nota interna<input name="nota" maxlength="500" value="@c.NotaInterna" /></label></div>
                <label class="agenda-consentimiento"><input type="checkbox" name="telefonoValidado" value="true" checked="@c.TelefonoValidado" /> He contactado con este teléfono y validado la cita.</label><div class="agenda-botones"><button class="btn btn-primary" name="estado" value="Confirmada">@(c.Estado==EstadoCita.Confirmada?"Actualizar duración":c.Estado==EstadoCita.PendienteAceptacion?"Guardar ajustes":"Preparar propuesta")</button><button class="btn btn-gray" name="estado" value="@(c.Estado==EstadoCita.Pendiente?"Rechazada":"Cancelada")">@(c.Estado==EstadoCita.Pendiente?"Rechazar":"Cancelar cita")</button>@if(c.Estado==EstadoCita.Confirmada){<button class="btn btn-gray" name="estado" value="Completada">Completar</button>}</div>
            </form>
        }else if(!string.IsNullOrEmpty(c.NotaInterna)){<p>@c.NotaInterna</p>}
        </div></article>
    }</section>
}
@if(Model.Citas.Count==0){<div class="card agenda-sin-huecos">La agenda de esta semana está libre.</div>}
</div>
<section id="comunicaciones" class="agenda-comunicaciones">
    <h2>Comunicaciones</h2>
    <p>@(Model.CorreoConfigurado ? "Correo SMTP configurado. La aceptación del servidor no acredita la lectura ni la aceptación de la cita." : "Correo pendiente de configurar. Los avisos se conservan en la cola hasta configurar SMTP y activar el envío.")</p>
    <p>WhatsApp se envía manualmente: abre el mensaje, envíalo en WhatsApp y márcalo como enviado. La cita se confirma únicamente cuando el cliente acepta el enlace.</p>
    @if(!Model.EnlaceConfigurado){<div class="agenda-avisos" role="status">Falta configurar la URL pública HTTPS para generar los enlaces de confirmación.</div>}
    @foreach(var m in Model.Mensajes)
    {
        <article class="card"><div class="agenda-botones"><strong>@m.Destinatario</strong><span class="badge">@m.Canal · @(m.Estado==EstadoNotificacion.AceptadoServidor?"Aceptado por el servidor de correo":m.Estado.ToString())</span></div><p>@m.Texto</p>
        @if(m.WhatsApp is not null)
        {
            <div class="agenda-botones"><a class="btn btn-primary" href="@m.WhatsApp.AbsoluteUri" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">Abrir mensaje en WhatsApp</a>
                <form method="post" action="/admin/agenda/whatsapp-enviado">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id" /><button class="btn btn-gray">Ya lo he enviado en WhatsApp</button></form></div>
        }
        @if(m.Canal==CanalConfirmacion.Correo && m.Estado==EstadoNotificacion.Error)
        {
            <form method="post" action="/admin/agenda/reintentar-correo">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id" /><button class="btn btn-gray">Reintentar correo</button></form>
        }
        @if(m.Estado==EstadoNotificacion.Incierto){<p class="nota">Se desconoce si llegó a enviarse. Revisa el servidor antes de volver a contactar para evitar mensajes duplicados.</p>}
        </article>
    }
</section>
