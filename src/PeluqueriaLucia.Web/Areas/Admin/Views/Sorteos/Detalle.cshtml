@using PeluqueriaLucia.Application.Sorteos
@using PeluqueriaLucia.Domain.Sorteos
@model SorteoDetalleModelo
@{
    var s = Model.Sorteo;
    var hoy = Model.Hoy;
    ViewData["Title"] = s.Titulo;
    var ganador = s.Ganador;
    var fichaGanador = Model.DelGanador?.Cliente;
    var participantes = Model.Participantes;
    var candidatos = participantes.Where(p => !s.HaGanado(p)).ToList();
    var premios = s.Premios;
    var puedeSortear = participantes.Count >= 2 && premios.Count > 0;
    var a = Model.Anuncio;
    // La ruleta pasa hasta 60 participantes, en desorden, con su número
    var nombres = System.Text.Json.JsonSerializer.Serialize(participantes.OrderBy(_ => Random.Shared.Next()).Take(60).Select(p => p.Etiqueta));
}

<div>
    <a class="back-link" asp-action="Index" asp-route-vista="@(s.Abierto ? "Activos" : "Historial")"><icono nombre="anterior" tamano="20" /> Sorteos</a>
    <header class="page-head">
        <div class="titulo-con-avatar">
            <span class="sorteo-tarjeta-sello sorteo-sello-grande"><icono nombre="regalo" tamano="30" /></span>
            <div>
                <h1>@s.Titulo</h1>
                <p class="subtitle"><span class="pill @FormatoSorteos.Tinte(s)">@FormatoSorteos.Estado(s)</span> @(s.Abierto ? FormatoSorteos.Cuando(s, hoy) : "Previsto el " + SorteosService.Cuando(s.FechaSorteo))</p>
            </div>
        </div>
        <div class="acciones">
            <a class="btn btn-gray" asp-action="Tablero" asp-route-id="@s.Id"><icono nombre="cuadricula" tamano="18" /> Tablero</a>
            @if (s.Abierto)
            {
                <a class="btn btn-gray" asp-action="Editar" asp-route-id="@s.Id"><icono nombre="editar" tamano="18" /> Editar</a>
            }
            @if (s.Extracciones.Count == 0)
            {
                <form method="post" asp-action="Eliminar" asp-route-id="@s.Id" data-confirmar="El sorteo «@s.Titulo» se borrará con sus premios, participantes y anuncios. No se puede deshacer.">
                    <button class="btn btn-gray btn-destructive"><icono nombre="papelera" tamano="18" /> Eliminar</button>
                </form>
            }
        </div>
    </header>

    <div asp-validation-summary="All"></div>

    <div class="detalle-grid">
        <section>
            <div class="card card-pad sorteo-datos">
                <p class="etiqueta">Así se anuncia</p>
                <p><strong>@s.Titulo</strong> · <span class="muted" lang="en">@s.TituloEn</span></p>
                @if (s.Descripcion is not null)
                {
                    <p class="muted small">@s.Descripcion</p>
                }
            </div>

            <div class="section" id="premios">
                <div class="section-head">
                    <h2>Premios · @premios.Count</h2>
                    @if (s.Abierto && premios.Count == 0)
                    {
                        <span class="muted small">Hace falta al menos uno para sortear</span>
                    }
                </div>
                @if (premios.Count == 0)
                {
                    <p class="card card-pad muted small">Todavía no hay premios. Añade servicios del catálogo, productos de la tienda o productos de sorteo (lo que sorteas y no es de la peluquería).</p>
                }
                else
                {
                    <div class="list sorteo-premios">
                        @foreach (var p in premios)
                        {
                            <div class="row">
                                <span class="sorteo-premio-icono @FormatoSorteos.TintePremio(p.Tipo)"><icono nombre="@FormatoSorteos.IconoPremio(p.Tipo)" tamano="18" /></span>
                                <span class="row-main">
                                    <span class="row-title">@if (p.Cantidad > 1) {<span class="sorteo-premio-cantidad">@p.Cantidad × </span>}@p.Nombre</span>
                                    <span class="row-sub">@FormatoSorteos.TipoPremioTexto(p.Tipo)@if (p.NombreEn is { } nombreEn && nombreEn != p.Nombre) {<text> · <span lang="en">@nombreEn</span></text>}</span>
                                    @if (p.Descripcion is not null)
                                    {
                                        <span class="row-sub">@p.Descripcion</span>
                                    }
                                </span>
                                @if (p.Tipo == TipoPremio.ProductoSorteo && p.ProductoSorteoId is { } productoSorteoId)
                                {
                                    <a class="btn btn-gray btn-icono" asp-controller="ProductosSorteo" asp-action="Ficha" asp-route-id="@productoSorteoId" aria-label="Ver «@p.Nombre» en Productos de sorteo" title="Ver en Productos de sorteo"><icono nombre="siguiente" tamano="15" /></a>
                                }
                                @if (s.Abierto)
                                {
                                    <form method="post" asp-action="QuitarPremio" asp-route-id="@s.Id" asp-route-premioId="@p.Id"
                                          data-confirmar-titulo="¿Quitar este premio?" data-confirmar="«@p.Nombre» dejará de ser premio de este sorteo." data-confirmar-accion="Quitar">
                                        <button class="btn btn-gray btn-icono" aria-label="Quitar «@p.Nombre» de los premios" title="Quitar de los premios"><icono nombre="cerrar" tamano="15" /></button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
                @if (s.Abierto && Model.Opciones is { } o)
                {
                    <form class="card card-pad sorteo-agregar-premio" method="post" asp-action="AgregarPremio" asp-route-id="@s.Id" novalidate>
                        <div class="sorteo-premio-campos">
                            <div class="field">
                                <label for="premio">Añadir un premio</label>
                                <select class="input" id="premio" name="premio" required data-buscable="Buscar servicio o producto" data-buscable-vacio="Nada con ese texto. Si no es de la peluquería, créalo como producto de sorteo.">
                                    <option value="">Elige el premio</option>
                                    @if (o.ProductosSorteo.Count > 0)
                                    {
                                        <optgroup label="Productos de sorteo">
                                            @foreach (var ps in o.ProductosSorteo)
                                            {
                                                <option value="@ClavePremio.De(TipoPremio.ProductoSorteo, ps.Id)" data-buscar="producto de sorteo @ps.Nombre">@ps.Nombre · producto de sorteo</option>
                                            }
                                        </optgroup>
                                    }
                                    <optgroup label="Servicios del catálogo">
                                        @foreach (var sv in o.Servicios)
                                        {
                                            <option value="@ClavePremio.De(TipoPremio.Servicio, sv.Id)" data-buscar="servicio @sv.Nombre">@sv.Nombre · servicio@(sv.Precio > 0 ? " · " + Formato.Euros(sv.Precio) : "")</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Productos de la tienda">
                                        @foreach (var pr in o.Productos)
                                        {
                                            <option value="@ClavePremio.De(TipoPremio.Producto, pr.Id)" data-buscar="producto @pr.Nombre @pr.Referencia">@pr.Nombre · producto · @Formato.Euros(pr.PrecioVenta)</option>
                                        }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="field">
                                <label for="cantidad">Cantidad</label>
                                <input class="input" type="number" id="cantidad" name="cantidad" value="1" min="1" max="@PremioSorteo.CantidadMaxima" step="1" inputmode="numeric" required />
                            </div>
                        </div>
                        <div class="acciones">
                            <button class="btn btn-primary"><icono nombre="mas" tamano="17" /> Añadir premio</button>
                            <a class="btn btn-gray" asp-controller="ProductosSorteo" asp-action="Nuevo" asp-route-sorteo="@s.Id"><icono nombre="regalo" tamano="17" /> Nuevo producto de sorteo</a>
                        </div>
                        <p class="field-hint">¿Sorteas algo que no es de la peluquería, como una cena o unas entradas? Créalo como producto de sorteo, con su nombre y su descripción, y se añade aquí.</p>
                    </form>
                }
            </div>

            <div class="section" id="participantes">
                <div class="section-head">
                    <h2>Participantes · @participantes.Count</h2>
                    @if (s.Abierto && participantes.Count < 2)
                    {
                        <span class="muted small">Hacen falta al menos dos para sortear</span>
                    }
                    else
                    {
                        <a asp-action="Tablero" asp-route-id="@s.Id">Ver el tablero <icono nombre="flecha" tamano="14" /></a>
                    }
                </div>
                @if (s.Abierto)
                {
                    <div class="card card-pad sorteo-agregar">
                        <form class="sorteo-agregar-cliente" method="post" asp-action="AgregarParticipante" asp-route-id="@s.Id" data-participante-agregar>
                            <input type="hidden" name="clienteId" data-cliente-id />
                            <div class="combo" data-combo>
                                <div class="search search-full">
                                    <icono nombre="buscar" tamano="17" />
                                    <input class="input" type="search" placeholder="Buscar cliente para añadir" autocomplete="off"
                                           role="combobox" aria-expanded="false" aria-controls="combo-lista" aria-autocomplete="list"
                                           aria-label="Buscar cliente para añadir al sorteo, por nombre, teléfono o email" data-combo-input data-url-buscar="@Url.Action("Buscar", "Clientes", new { area = "Admin" })" />
                                </div>
                                <ul class="combo-lista list" id="combo-lista" role="listbox" data-combo-lista hidden></ul>
                            </div>
                            <input class="input sorteo-numero-campo" type="number" name="numero" min="1" max="@Sorteo.NumeroMaximo" step="1" inputmode="numeric"
                                   placeholder="Nº @Model.SiguienteNumero" aria-label="Su número (opcional; si no, el @Model.SiguienteNumero)" title="Su número. Si no escribes ninguno, el siguiente libre (@Model.SiguienteNumero)" />
                        </form>
                        <p class="field-hint sorteo-agregar-pista">Cada participante lleva un número. Si no escribes ninguno, el cliente se lleva el siguiente libre.</p>
                        <details class="sorteo-mas" open="@(Model.TextoNumeros is not null)">
                            <summary>Meter números a mano (papeletas, un sorteo que ya tienes en otro sitio…)</summary>
                            <form class="sorteo-numeros" method="post" asp-action="AgregarNumeros" asp-route-id="@s.Id">
                                @{
                                    // Si lo escrito no vale, el error sale también aquí, junto al texto, y la página baja hasta él
                                    var errorNumeros = ViewData.ModelState["Numeros"]?.Errors.FirstOrDefault()?.ErrorMessage;
                                }
                                <div class="field">
                                    <label for="numeros">Números</label>
                                    <textarea class="input" id="numeros" name="numeros" rows="4" required maxlength="@LectorNumerosSorteo.LongitudMaxima" spellcheck="false" placeholder="1-50&#10;51 María López&#10;60, 61, 75 Juan"
                                              autofocus="@(errorNumeros is not null)" aria-invalid="@(errorNumeros is null ? null : "true")" aria-describedby="@(errorNumeros is null ? null : "numeros-error")">@Model.TextoNumeros</textarea>
                                    @if (errorNumeros is not null)
                                    {
                                        <p class="field-validation-error" id="numeros-error">@errorNumeros</p>
                                    }
                                    <p class="field-hint">Una línea por persona: primero los números, sueltos o en rangos como «1-50», y después, si quieres, el nombre de quien los tiene. No necesitan ficha de cliente. Los números que ya estén en el sorteo se quedan como están.</p>
                                </div>
                                <button class="btn btn-gray"><icono nombre="mas" tamano="17" /> Añadir números</button>
                            </form>
                        </details>
                        <details class="sorteo-mas">
                            <summary>Añadir de golpe a los clientes que vinieron entre dos fechas</summary>
                            <form class="sorteo-visitas" method="post" asp-action="AgregarVisitas" asp-route-id="@s.Id">
                                <div class="fields-2">
                                    <div class="field"><label for="desdeVisitas">Desde</label><input class="input" type="date" id="desdeVisitas" name="desdeVisitas" value="@hoy.AddMonths(-1).ToString("yyyy-MM-dd")" required /></div>
                                    <div class="field"><label for="hastaVisitas">Hasta</label><input class="input" type="date" id="hastaVisitas" name="hastaVisitas" value="@hoy.ToString("yyyy-MM-dd")" required /></div>
                                </div>
                                <button class="btn btn-gray"><icono nombre="clientes" tamano="17" /> Añadir a esos clientes</button>
                            </form>
                        </details>
                    </div>
                }
                @if (participantes.Count == 0)
                {
                    <p class="card card-pad muted small">Todavía no participa nadie. Busca a tus clientes arriba, añade de golpe a los que vinieron en unas fechas o mete números a mano.</p>
                }
                else
                {
                    <div class="list list-avatars sorteo-participantes">
                        @foreach (var p in participantes)
                        {
                            var c = p.Cliente;
                            var esGanador = ganador?.Es(p) == true;
                            <div class="row @(esGanador ? "is-ganador" : "")">
                                <span class="avatar sorteo-numero @(c is null ? "tint-gray" : Formato.Tinte(c.Sexo))" title="Número @p.Numero">@p.Numero</span>
                                <span class="row-main">
                                    @if (p.ClienteId is { } clienteId)
                                    {
                                        <a class="row-title" asp-controller="Clientes" asp-action="Detalle" asp-route-id="@clienteId">@(c?.NombreCompleto ?? "Cliente")</a>
                                        <span class="row-sub">@(c?.Telefono ?? c?.Email ?? "Sin teléfono ni correo")</span>
                                    }
                                    else
                                    {
                                        <span class="row-title">@(p.Nombre ?? "Sin nombre")</span>
                                        <span class="row-sub">Número metido a mano, sin ficha</span>
                                    }
                                </span>
                                @if (esGanador)
                                {
                                    <span class="pill tint-green"><icono nombre="estrella" tamano="13" /> Ganador</span>
                                }
                                else if (s.HaGanado(p))
                                {
                                    <span class="pill tint-gray">Ganó antes</span>
                                }
                                @if (s.Abierto)
                                {
                                    <details class="sorteo-cambiar">
                                        <summary class="btn btn-gray btn-icono" aria-label="Cambiar el número @p.Numero" title="Cambiar el número"><icono nombre="editar" tamano="15" /></summary>
                                        <form class="sorteo-cambiar-form" method="post" asp-action="CambiarNumero" asp-route-id="@s.Id" asp-route-numero="@p.Numero">
                                            <div class="field">
                                                <label for="nuevo-@p.Numero">Número</label>
                                                <input class="input" type="number" id="nuevo-@p.Numero" name="nuevo" value="@p.Numero" min="1" max="@Sorteo.NumeroMaximo" step="1" inputmode="numeric" required />
                                            </div>
                                            @if (p.ClienteId is null)
                                            {
                                                <div class="field">
                                                    <label for="nombre-@p.Numero">Quién lo tiene <span class="muted">(opcional)</span></label>
                                                    <input class="input" id="nombre-@p.Numero" name="nombre" value="@p.Nombre" maxlength="@ParticipanteSorteo.LongitudNombre" autocomplete="off" />
                                                </div>
                                            }
                                            <button class="btn btn-primary btn-sm">Guardar</button>
                                        </form>
                                    </details>
                                    <form method="post" asp-action="QuitarParticipante" asp-route-id="@s.Id" asp-route-numero="@p.Numero"
                                          data-confirmar-titulo="¿Quitar del sorteo?" data-confirmar="El número @p.Numero@(p.NombreVisible is { } quien ? $" ({quien})" : "") dejará de participar y quedará libre." data-confirmar-accion="Quitar">
                                        <button class="btn btn-gray btn-icono" aria-label="Quitar el número @p.Numero (@(p.NombreVisible ?? "sin nombre")) del sorteo" title="Quitar del sorteo"><icono nombre="cerrar" tamano="15" /></button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section>
            @if (s.Abierto)
            {
                <div class="card card-pad sorteo-sortear" id="ganador">
                    <span class="sorteo-sortear-sello"><icono nombre="regalo" tamano="34" /></span>
                    <h2>¿Listo para sortear?</h2>
                    <p class="muted">
                        @if (premios.Count == 0)
                        {
                            <text>Antes, añade al menos un premio.</text>
                        }
                        else
                        {
                            <text>Se sortea @s.PremiosEnTexto() al azar entre @(participantes.Count == 1 ? "1 participante" : $"{participantes.Count} participantes"): todos tienen la misma probabilidad. Queda en el historial cuándo, entre cuántos y quién ganó.</text>
                        }
                    </p>
                    <form method="post" asp-action="Sortear" asp-route-id="@s.Id" data-confirmar="Premio: @s.PremiosEnTexto(). Se sortea entre @participantes.Count participantes. ¿Sorteamos ahora?">
                        <button class="btn btn-primary btn-lg btn-block sorteo-boton" disabled="@(!puedeSortear)"><icono nombre="regalo" tamano="20" /> Sortear ahora</button>
                    </form>
                    @if (participantes.Count > 0 && premios.Count > 0)
                    {
                        <details class="sorteo-mas">
                            <summary>Prefiero elegir yo al ganador</summary>
                            <form class="sorteo-elegir" method="post" asp-action="ElegirGanador" asp-route-id="@s.Id">
                                <div class="field">
                                    <label for="ganador-elegido">Ganador</label>
                                    <select class="input" id="ganador-elegido" name="numero" required data-buscable="Buscar por número o nombre">
                                        <option value="">Elige un participante</option>
                                        @foreach (var p in participantes)
                                        {
                                            <option value="@p.Numero">@p.Etiqueta</option>
                                        }
                                    </select>
                                    <p class="field-hint">¿Has sorteado en otro sitio (papeletas, la lotería…)? Elige aquí el número que ha salido.</p>
                                </div>
                                <div class="field"><label for="motivo-eleccion">Motivo <span class="muted">(opcional)</span></label><input class="input" id="motivo-eleccion" name="motivo" maxlength="@Sorteo.LongitudMotivo" autocomplete="off" placeholder="Sorteo hecho en el salón con papeletas…" /></div>
                                <button class="btn btn-gray">Elegir ganador</button>
                            </form>
                        </details>
                    }
                    <details class="sorteo-mas sorteo-cancelar">
                        <summary>Cancelar el sorteo</summary>
                        <form method="post" asp-action="Cancelar" asp-route-id="@s.Id" data-confirmar="El sorteo se cancelará y la web dejará de anunciarlo. Queda en el historial.">
                            <div class="field"><label for="motivo-cancelar">Motivo <span class="muted">(opcional)</span></label><input class="input" id="motivo-cancelar" name="motivo" maxlength="@Sorteo.LongitudMotivo" autocomplete="off" /></div>
                            <button class="btn btn-gray btn-destructive">Cancelar el sorteo</button>
                        </form>
                    </details>
                </div>
            }
            else if (ganador is not null)
            {
                <div class="card card-pad sorteo-ganador" id="ganador" data-revelar="@(Model.Revelar ? "true" : "false")" data-nombres="@nombres" data-ganador="@ganador.Etiqueta">
                    <div class="sorteo-ruleta" data-ruleta hidden aria-hidden="true"><span data-ruleta-nombre></span></div>
                    <div class="sorteo-ganador-contenido" data-ganador-contenido>
                        <p class="etiqueta">¡Tenemos ganador!</p>
                        <span class="avatar avatar-lg @(fichaGanador is null ? "tint-gray" : Formato.Tinte(fichaGanador.Sexo)) @(ganador.Numero is null ? "" : "sorteo-numero")">@(ganador.Numero?.ToString() ?? fichaGanador?.Iniciales ?? "?")</span>
                        <h2>@ganador.Etiqueta</h2>
                        <p class="muted">@SorteosService.Como(ganador) · @SorteosService.Cuando(ganador.Fecha)</p>
                        <p class="muted small">Gana @FormatoSorteos.Premios(s)</p>
                        <div class="sorteo-ganador-estado">
                            <span class="pill @(ganador.AvisoCanal is null ? "tint-orange" : "tint-green")">@FormatoSorteos.Aviso(ganador)</span>
                            <span class="pill @(ganador.EntregadoEn is null ? "tint-orange" : "tint-green")">@FormatoSorteos.Entrega(ganador)</span>
                        </div>
                        @if (ganador.EntregadoEn is null)
                        {
                            <form method="post" asp-action="MarcarEntregado" asp-route-id="@s.Id" data-confirmar="¿@ganador.Ganador ya tiene su premio? Queda anotado en el historial y el ganador ya no se podrá cambiar." data-confirmar-accion="Sí, entregado">
                                <button class="btn btn-gray btn-sm"><icono nombre="check" tamano="16" /> Marcar premio entregado</button>
                            </form>
                        }
                    </div>
                    <span class="sorteo-confeti" data-confeti aria-hidden="true"></span>
                </div>

                @if (Model.Aviso is { } aviso)
                {
                    <div class="section">
                        <div class="section-head"><h2>Avisar al ganador</h2></div>
                        <form class="card card-pad sorteo-aviso" method="post" asp-action="AvisarCorreo" asp-route-id="@s.Id">
                            <div class="field">
                                <label for="textoAviso">Mensaje</label>
                                <textarea class="input" id="textoAviso" name="textoAviso" rows="5" maxlength="2000" required>@(Model.TextoAviso ?? aviso.Texto)</textarea>
                                <p class="field-hint">@(aviso.SinFicha
                                    ? "Ha ganado un número metido a mano, sin ficha de cliente: copia el mensaje y avísale por tu cuenta (en persona, por teléfono…)."
                                    : "Revísalo antes de enviarlo. Por WhatsApp se abre la conversación con el mensaje escrito y lo envías tú.")</p>
                            </div>
                            <div class="acciones">
                                <button class="btn btn-primary" disabled="@(aviso.Correo is null || !Model.CorreoConfigurado)" title="@(aviso.Correo is null ? "Su ficha no tiene correo" : !Model.CorreoConfigurado ? "El correo del servidor no está configurado" : aviso.Correo)">
                                    <icono nombre="email" tamano="17" /> Enviar por correo
                                </button>
                                <button class="btn btn-success" asp-action="AvisarWhatsApp" asp-route-id="@s.Id" formtarget="_blank" disabled="@(aviso.WhatsApp is null)" title="@(aviso.WhatsApp ?? "Su ficha no tiene un móvil válido")">
                                    <icono nombre="telefono" tamano="17" /> Abrir WhatsApp
                                </button>
                            </div>
                            @if (aviso.Correo is null && aviso.WhatsApp is null && !aviso.SinFicha)
                            {
                                <p class="field-hint texto-aviso">Su ficha no tiene correo ni móvil. <a asp-controller="Clientes" asp-action="Detalle" asp-route-id="@ganador.ClienteId">Completa la ficha</a> o llámale.</p>
                            }
                        </form>
                    </div>
                }

                @if (ganador.EntregadoEn is null)
                {
                    <details class="sorteo-mas sorteo-otra-vez">
                        <summary>Repetir el sorteo o elegir otro ganador</summary>
                        <div class="card card-pad sorteo-repetir">
                            @if (candidatos.Count > 0)
                            {
                                <form method="post" asp-action="Repetir" asp-route-id="@s.Id">
                                    <p class="muted small">Se vuelve a sortear entre los @candidatos.Count participantes que aún no han ganado. La extracción anterior se conserva en el historial con el motivo.</p>
                                    <div class="field"><label for="motivo-repetir">Motivo</label><input class="input" id="motivo-repetir" name="motivo" maxlength="@Sorteo.LongitudMotivo" required autocomplete="off" placeholder="No ha respondido, no puede venir…" /></div>
                                    <button class="btn btn-gray"><icono nombre="regalo" tamano="17" /> Repetir el sorteo</button>
                                </form>
                                <form method="post" asp-action="ElegirGanador" asp-route-id="@s.Id">
                                    <div class="field">
                                        <label for="otro-ganador">O elige tú a otro ganador</label>
                                        <select class="input" id="otro-ganador" name="numero" required data-buscable="Buscar por número o nombre">
                                            <option value="">Elige un participante</option>
                                            @foreach (var p in candidatos)
                                            {
                                                <option value="@p.Numero">@p.Etiqueta</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field"><label for="motivo-otro">Motivo</label><input class="input" id="motivo-otro" name="motivo" maxlength="@Sorteo.LongitudMotivo" required autocomplete="off" /></div>
                                    <button class="btn btn-gray">Elegir ganador</button>
                                </form>
                            }
                            else
                            {
                                <p class="muted small">Ya han ganado todos los participantes: no queda nadie entre quien sortear.</p>
                            }
                        </div>
                    </details>
                }
            }
            else
            {
                <div class="card card-pad sorteo-cancelado">
                    <h2>Sorteo cancelado</h2>
                    <p class="muted">@(s.MotivoCancelacion ?? "Sin motivo indicado.")</p>
                </div>
            }

            <div class="section" id="anuncios">
                @{
                    // El que se ve hoy o, si no, el próximo: la tarjeta de estado sustituye al formulario de anunciar
                    var enLaWeb = s.Anuncios.FirstOrDefault(x => x.VisibleEl(hoy));
                    var actual = enLaWeb ?? s.Anuncios.Where(x => x.Desde > hoy).OrderBy(x => x.Desde).FirstOrDefault();
                    var otros = s.Anuncios.Where(x => x != actual).OrderByDescending(x => x.Desde).ToList();
                    var cambiando = actual is not null && a.AnuncioId == actual.Id;
                }
                <div class="section-head"><h2>Anuncio en la web</h2><a asp-area="" asp-controller="SorteosWeb" asp-action="Index" target="_blank" rel="noopener">Ver en la web <icono nombre="flecha-salir" tamano="14" /></a></div>
                @if (actual is not null)
                {
                    <div class="card card-pad sorteo-anuncio-estado @(enLaWeb is null ? "is-programado" : "is-en-la-web")">
                        <div class="sorteo-anuncio-cabecera">
                            <span class="sorteo-anuncio-icono"><icono nombre="web" tamano="22" /></span>
                            <div>
                                <p class="sorteo-anuncio-etiqueta">@(enLaWeb is null ? "Programado" : "En la web ahora")</p>
                                <p class="sorteo-anuncio-fechas">@(enLaWeb is null
                                    ? $"Se verá del {actual.Desde:dd/MM/yyyy} al {actual.Hasta:dd/MM/yyyy}"
                                    : $"Se ve hasta el {actual.Hasta:dd/MM/yyyy}")</p>
                            </div>
                        </div>
                        <blockquote class="sorteo-anuncio-texto">
                            <p>@actual.Texto</p>
                            @if (actual.TextoEn is { Length: > 0 } textoEn)
                            {
                                <p class="muted" lang="en">@textoEn</p>
                            }
                        </blockquote>
                        <div class="sorteo-anuncio-acciones">
                            <form method="post" asp-action="TerminarAnuncio" asp-route-id="@s.Id" asp-route-anuncioId="@actual.Id"
                                  data-confirmar-titulo="@(enLaWeb is null ? "¿Cancelar el anuncio?" : "¿Dejar de mostrarlo en la web?")"
                                  data-confirmar="@(enLaWeb is null ? "El anuncio programado no llegará a verse en la web." : "El aviso flotante y la página «Sorteos» dejarán de enseñar este sorteo desde ahora.") Podrás volver a anunciarlo."
                                  data-confirmar-accion="@(enLaWeb is null ? "Cancelar anuncio" : "Dejar de mostrar")">
                                <button class="btn btn-gray btn-destructive"><icono nombre="ojo-tachado" tamano="17" /> @(enLaWeb is null ? "Cancelar el anuncio" : "Dejar de mostrar en la web")</button>
                            </form>
                            @if (s.Abierto)
                            {
                                <a class="btn btn-primary" href="#ganador"><icono nombre="regalo" tamano="17" /> Finalizar el sorteo</a>
                            }
                        </div>
                        <details class="sorteo-mas sorteo-anuncio-cambiar" open="@cambiando">
                            <summary>Cambiar el texto o las fechas</summary>
                            <form class="sorteo-anunciar" method="post" asp-action="CambiarAnuncio" asp-route-id="@s.Id" asp-route-anuncioId="@actual.Id" novalidate>
                                <div class="field">
                                    <label for="TextoAnuncio">Texto del anuncio</label>
                                    <textarea class="input" id="TextoAnuncio" name="TextoAnuncio" rows="2" maxlength="@AnuncioSorteo.LongitudTexto" required>@(cambiando ? a.TextoAnuncio : actual.Texto)</textarea>
                                </div>
                                <div class="field">
                                    <label for="TextoAnuncioEn">Texto en inglés</label>
                                    <textarea class="input" id="TextoAnuncioEn" name="TextoAnuncioEn" rows="2" maxlength="@AnuncioSorteo.LongitudTexto" required lang="en">@(cambiando ? a.TextoAnuncioEn : actual.TextoEn)</textarea>
                                </div>
                                <div class="fields-2">
                                    <div class="field"><label for="DesdeAnuncio">Se ve desde</label><input class="input" type="date" id="DesdeAnuncio" name="DesdeAnuncio" value="@((cambiando ? a.DesdeAnuncio : actual.Desde)?.ToString("yyyy-MM-dd"))" required /></div>
                                    <div class="field"><label for="HastaAnuncio">Hasta</label><input class="input" type="date" id="HastaAnuncio" name="HastaAnuncio" value="@((cambiando ? a.HastaAnuncio : actual.Hasta)?.ToString("yyyy-MM-dd"))" required /></div>
                                </div>
                                <button class="btn btn-primary">Guardar cambios</button>
                            </form>
                        </details>
                    </div>
                }
                else if (s.Estado == EstadoSorteo.Cancelado)
                {
                    <p class="card card-pad muted small">El sorteo está cancelado: la web no lo anuncia.</p>
                }
                else
                {
                    <form class="card card-pad sorteo-anunciar" method="post" asp-action="Anunciar" asp-route-id="@s.Id" novalidate>
                        <p class="muted small">La web enseña un aviso flotante y la página «Sorteos» con los premios, la fecha y este texto, entre las fechas que elijas. Nunca enseña a los participantes ni al ganador.</p>
                        <div class="field">
                            <label for="TextoAnuncio">Texto del anuncio</label>
                            <textarea class="input" id="TextoAnuncio" name="TextoAnuncio" rows="2" maxlength="@AnuncioSorteo.LongitudTexto" required placeholder="Por cada visita en diciembre entras en el sorteo de…">@a.TextoAnuncio</textarea>
                        </div>
                        <div class="field">
                            <label for="TextoAnuncioEn">Texto en inglés</label>
                            <textarea class="input" id="TextoAnuncioEn" name="TextoAnuncioEn" rows="2" maxlength="@AnuncioSorteo.LongitudTexto" required lang="en">@a.TextoAnuncioEn</textarea>
                        </div>
                        <div class="fields-2">
                            <div class="field"><label for="DesdeAnuncio">Se ve desde</label><input class="input" type="date" id="DesdeAnuncio" name="DesdeAnuncio" value="@a.DesdeAnuncio?.ToString("yyyy-MM-dd")" required /></div>
                            <div class="field"><label for="HastaAnuncio">Hasta</label><input class="input" type="date" id="HastaAnuncio" name="HastaAnuncio" value="@a.HastaAnuncio?.ToString("yyyy-MM-dd")" required /></div>
                        </div>
                        <button class="btn btn-primary"><icono nombre="web" tamano="17" /> Anunciar en la web</button>
                    </form>
                }
                @if (otros.Count > 0)
                {
                    <details class="sorteo-mas sorteo-anuncios-historial">
                        <summary>@(otros.Count == 1 ? "Otro anuncio" : $"Otros anuncios · {otros.Count}")</summary>
                        <div class="list sorteo-anuncios">
                            @foreach (var anuncio in otros)
                            {
                                var (estadoAnuncio, tinteAnuncio) = FormatoSorteos.EstadoAnuncio(anuncio, hoy);
                                <div class="row">
                                    <span class="row-main">
                                        <span class="row-title">@anuncio.Texto</span>
                                        <span class="row-sub">Del @anuncio.Desde.ToString("dd/MM/yyyy") al @anuncio.Hasta.ToString("dd/MM/yyyy")</span>
                                    </span>
                                    <span class="pill @tinteAnuncio">@estadoAnuncio</span>
                                    <form method="post" asp-action="QuitarAnuncio" asp-route-id="@s.Id" asp-route-anuncioId="@anuncio.Id"
                                          data-confirmar-titulo="¿Borrar este anuncio?" data-confirmar="@(anuncio.Hasta < hoy ? "Se borrará del historial del sorteo." : "No llegará a verse en la web y se borrará.")" data-confirmar-accion="Borrar">
                                        <button class="btn btn-gray btn-icono" aria-label="Borrar este anuncio" title="Borrar"><icono nombre="cerrar" tamano="15" /></button>
                                    </form>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>

            @if (s.Extracciones.Count > 0)
            {
                <div class="section">
                    <div class="section-head"><h2>Historial del sorteo</h2></div>
                    <div class="list">
                        @foreach (var e in s.Extracciones.OrderByDescending(x => x.Fecha).ThenByDescending(x => x.Id))
                        {
                            <div class="row sorteo-extraccion @(e == ganador ? "" : "is-anterior")">
                                <span class="row-main">
                                    <span class="row-title">@e.Etiqueta@(e == ganador ? "" : " · anterior")</span>
                                    <span class="row-sub">@e.Fecha.ToString("dd/MM/yyyy HH:mm") · @SorteosService.Como(e)@(e.Motivo is null ? "" : " · " + e.Motivo) · @FormatoSorteos.Aviso(e)@(e.EntregadoEn is null ? "" : " · " + FormatoSorteos.Entrega(e))</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/combo-clientes.js" asp-append-version="true"></script>
    <script src="~/js/sorteos.js" asp-append-version="true"></script>
}
