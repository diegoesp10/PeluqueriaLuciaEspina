@using PeluqueriaLucia.Domain.Sorteos
@model SorteoEdicionModelo
@{
    var nuevo = Model.Id is null;
    ViewData["Title"] = nuevo ? "Nuevo sorteo" : "Editar sorteo";
    var f = Model.Formulario;
}

<div class="form-pagina">
    @if (nuevo)
    {
        <a class="back-link" asp-action="Index"><icono nombre="anterior" tamano="20" /> Sorteos</a>
    }
    else
    {
        <a class="back-link" asp-action="Detalle" asp-route-id="@Model.Id"><icono nombre="anterior" tamano="20" /> Sorteo</a>
    }
    <header class="page-head">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="subtitle">
                El título y la descripción se ven en la web cuando anuncies el sorteo, en español y en inglés.
                @(nuevo ? "Los premios y los participantes se añaden a continuación, en la pantalla del sorteo." : "Los premios se cambian en la pantalla del sorteo.")
            </p>
        </div>
    </header>

    <form class="form" method="post" asp-action="@(nuevo ? "Nuevo" : "Editar")" asp-route-id="@Model.Id" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="fields">
            <div class="field">
                <label for="Titulo">Título</label>
                <input class="input" id="Titulo" name="Titulo" value="@f.Titulo" maxlength="@Sorteo.LongitudTitulo" autocomplete="off" required autofocus="@nuevo"
                       placeholder="Por ejemplo, Sorteo de Navidad" />
                @Html.ValidationMessage("Titulo")
            </div>
            <div class="field">
                <label for="TituloEn">Título en inglés</label>
                <input class="input" id="TituloEn" name="TituloEn" value="@f.TituloEn" maxlength="@Sorteo.LongitudTitulo" autocomplete="off" lang="en" required
                       placeholder="For example, Christmas giveaway" />
                @Html.ValidationMessage("TituloEn")
            </div>

            <div class="field">
                <label for="FechaSorteo">Cuándo se sortea</label>
                <input class="input input-fecha" type="datetime-local" id="FechaSorteo" name="FechaSorteo" value="@f.FechaSorteo?.ToString("yyyy-MM-ddTHH:mm")" required />
                <p class="field-hint">El sorteo se hace cuando pulses «Sortear»; esta fecha es la que se anuncia y la que te recuerda el panel.</p>
                @Html.ValidationMessage("FechaSorteo")
            </div>

            <div class="field">
                <label for="Descripcion">Descripción <span class="muted">(opcional)</span></label>
                <textarea class="input" id="Descripcion" name="Descripcion" maxlength="@Sorteo.LongitudDescripcion" rows="3" placeholder="Quién participa, cómo se recoge el premio…">@f.Descripcion</textarea>
                @Html.ValidationMessage("Descripcion")
            </div>
            <div class="field">
                <label for="DescripcionEn">Descripción en inglés <span class="muted">(si escribes la española)</span></label>
                <textarea class="input" id="DescripcionEn" name="DescripcionEn" maxlength="@Sorteo.LongitudDescripcion" rows="3" lang="en">@f.DescripcionEn</textarea>
                @Html.ValidationMessage("DescripcionEn")
            </div>
        </div>

        <div class="acciones acciones-form">
            <button class="btn btn-primary btn-lg">@(nuevo ? "Crear y añadir los premios" : "Guardar cambios")</button>
        </div>
    </form>
</div>
