@model NuevaVisitaModelo
@{
    ViewData["Title"] = "Nueva visita";
    var f = Model.Formulario;
    var cliente = Model.Cliente;
    var filtroInicial = cliente?.Sexo.ToString() ?? "Todos";
    var seleccionados = f.Servicios.ToHashSet();
    var totalInicial = Model.Servicios.Where(s => seleccionados.Contains(s.Id)).Sum(s => s.Precio);
}

<form method="post" asp-action="Nueva" class="nueva-visita" data-nueva-visita novalidate>
    <a class="back-link" asp-action="Index"><icono nombre="anterior" tamano="20" /> Visitas</a>
    <header class="page-head">
        <div>
            <h1>Nueva visita</h1>
            <p class="subtitle">Elige el cliente y los servicios. Puedes cobrar ahora o más tarde.</p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly"></div>

    <div class="form form-ancho">
        @* ── Cliente ── *@
        <section>
            <div class="section-head">
                <h2>Cliente</h2>
                <a asp-controller="Clientes" asp-action="Nuevo" asp-route-visita="true"><icono nombre="cliente-nuevo" tamano="14" /> Cliente nuevo</a>
            </div>
            <div class="card card-pad">
                <input type="hidden" name="ClienteId" value="@f.ClienteId" data-cliente-id />

                <div class="cliente-elegido" data-cliente-elegido hidden="@(cliente is null)">
                    <span class="avatar @(cliente is null ? "" : Formato.Tinte(cliente.Sexo))" data-cliente-avatar>@cliente?.Iniciales</span>
                    <span class="row-main">
                        <span class="row-title" data-cliente-nombre>@cliente?.NombreCompleto</span>
                        <span class="row-sub" data-cliente-detalle>@(cliente?.Telefono ?? cliente?.Email)</span>
                    </span>
                    <button type="button" class="btn btn-gray btn-sm" data-cliente-cambiar>Cambiar</button>
                </div>

                <div class="combo" data-combo hidden="@(cliente is not null)">
                    <div class="search search-full">
                        <icono nombre="buscar" tamano="17" />
                        <input class="input" type="search" placeholder="Buscar por nombre, teléfono o email" autocomplete="off"
                               role="combobox" aria-expanded="false" aria-controls="combo-lista" aria-autocomplete="list"
                               aria-label="Buscar cliente" data-combo-input data-url-buscar="@Url.Action("Buscar", "Clientes", new { area = "Admin" })" />
                    </div>
                    <ul class="combo-lista list" id="combo-lista" role="listbox" data-combo-lista hidden></ul>
                </div>
                @Html.ValidationMessage("ClienteId")
            </div>
        </section>

        @* ── Fecha ── *@
        <section>
            <div class="section-head"><h2>Fecha y hora</h2></div>
            <div class="card card-pad">
                <input class="input input-fecha" type="datetime-local" name="Fecha" aria-label="Fecha y hora de la visita"
                       value="@f.Fecha?.ToString("yyyy-MM-ddTHH:mm")" required />
                @Html.ValidationMessage("Fecha")
            </div>
        </section>

        @* ── Servicios ── *@
        <section>
            <div class="section-head">
                <h2>Servicios</h2>
                <div class="segmented" role="radiogroup" aria-label="Mostrar servicios de">
                    @foreach (var opcion in new[] { "Mujer", "Hombre", "Otro", "Todos" })
                    {
                        <label><input type="radio" name="filtro-servicios" value="@opcion" checked="@(opcion == filtroInicial)" data-filtro-servicios /> @opcion</label>
                    }
                </div>
            </div>
            @if (Model.Servicios.Count == 0)
            {
                <div class="estado-vacio">
                    <span class="estado-icono tint-orange"><icono nombre="tijeras" tamano="28" /></span>
                    <h2>El catálogo está vacío</h2>
                    <p>Añade primero los servicios que ofreces, con su precio.</p>
                    <div class="acciones"><a class="btn btn-primary" asp-controller="Catalogo" asp-action="Nuevo">Añadir servicio</a></div>
                </div>
            }
            else
            {
                <div class="list" data-lista-servicios>
                    @foreach (var s in Model.Servicios)
                    {
                        <label class="row servicio-opcion" data-sexo="@s.Sexo">
                            <span class="row-main">
                                <span class="row-title">@s.Nombre</span>
                                <span class="row-sub">@Formato.Texto(s.Sexo)</span>
                            </span>
                            <span class="row-amount">@Formato.Euros(s.Precio)</span>
                            <input class="switch" type="checkbox" name="Servicios" value="@s.Id" data-precio="@Formato.ImporteJs(s.Precio)"
                                   checked="@seleccionados.Contains(s.Id)" aria-label="@s.Nombre, @Formato.Euros(s.Precio)" />
                        </label>
                    }
                    <p class="row muted small" data-sin-servicios hidden>No hay servicios para este filtro. Prueba con «Todos».</p>
                </div>
            }
            @Html.ValidationMessage("Servicios")
        </section>

        @* ── Pago ── *@
        <section>
            <div class="section-head"><h2>Forma de pago prevista</h2></div>
            <div class="segmented segmented-lg segmented-block">
                @foreach (var forma in new[] { FormaPago.Efectivo, FormaPago.Tarjeta, FormaPago.Mixto })
                {
                    <label>
                        <input type="radio" name="FormaPago" value="@forma" checked="@(f.FormaPago == forma)" />
                        <icono nombre="@Formato.Icono(forma)" tamano="17" /> @Formato.Texto(forma)
                    </label>
                }
            </div>
            <p class="section-foot">Se puede cambiar en el momento de cobrar.</p>
        </section>
    </div>

    <div class="barra-total glass">
        <div class="barra-total-cifras">
            <span class="muted small" data-numero-servicios>@(seleccionados.Count == 1 ? "1 servicio" : $"{seleccionados.Count} servicios")</span>
            <strong class="num" data-total>@Formato.Euros(totalInicial)</strong>
        </div>
        <div class="acciones">
            <button class="btn btn-gray" name="Accion" value="guardar">Guardar</button>
            <button class="btn btn-success" name="Accion" value="cobrar"><icono nombre="euro" tamano="18" /> Guardar y cobrar</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/nueva-visita.js" asp-append-version="true"></script>
}
