@model Visita
@{
    var cliente = Model.Cliente;
    var mostrarFecha = ViewData["MostrarFecha"] is true;
}
<a class="row" asp-controller="Visitas" asp-action="Detalle" asp-route-id="@Model.Id">
    <span class="avatar @(cliente is null ? "tint-gray" : Formato.Tinte(cliente.Sexo))">@(cliente?.Iniciales ?? "?")</span>
    <span class="row-main">
        <span class="row-title">@(cliente?.NombreCompleto ?? "Sin cliente")</span>
        <span class="row-sub">
            <span class="num">@(mostrarFecha ? Formato.FechaCorta(Model.Fecha) + " · " : "")@Formato.Hora(Model.Fecha)</span>
            · @string.Join(", ", Model.Lineas.Select(l => l.Nombre))
        </span>
    </span>
    <span class="row-end">
        @if (Model.EstaCobrada)
        {
            <span class="pill tint-green"><icono nombre="@Formato.Icono(Model.FormaPago)" tamano="13" /> @Formato.Texto(Model.FormaPago)</span>
        }
        else
        {
            <span class="pill tint-orange">Pendiente</span>
        }
        <span class="row-amount">@Formato.Euros(Model.Total)</span>
        <span class="row-chevron"><icono nombre="siguiente" tamano="16" /></span>
    </span>
</a>
