@using PeluqueriaLucia.Domain.Productos
@model VisitaDetalleModelo
@{
    var usados = Model.Cobro.Usados;
}
@* «¿Qué productos has utilizado?» al cobrar: tintes, oxidantes… gastados en el servicio. No se cobran; al cobrar salen del
   stock (si se acaban, queda en negativo). cobro-productos.js añade una fila por producto; tras un error vuelven del servidor. *@
<fieldset class="cobro-usados" data-productos-usados>
    <legend class="field-label">¿Qué productos has utilizado?</legend>
    <p class="field-hint">Tintes, oxidantes, mascarillas… No se cobran: se descuentan del stock al cobrar. Si alguno se acaba, su stock queda en negativo para reponerlo.</p>
    @if (Model.ParaVenta.Count == 0)
    {
        <p class="muted small">No hay productos en el inventario. <a asp-controller="Productos" asp-action="Nuevo">Da de alta los productos</a> para llevar su stock.</p>
    }
    else
    {
        <div class="producto-selector-fila">
            <div class="field producto-selector-buscar">
                <label class="sr-only" for="usado-elegir">Producto utilizado</label>
                <select class="input" id="usado-elegir" data-usado-elegir
                        data-buscable="Nombre, referencia o código de barras" data-buscable-vacio="Ningún producto del inventario con ese texto.">
                    <option value="">Sin elegir</option>
                    @foreach (var p in Model.ParaVenta)
                    {
                        <option value="@p.Id" data-stock="@Model.Disponibles(p.Id)" data-nombre="@p.Nombre" data-referencia="@p.Referencia"
                                data-foto="@(p.FotoPrincipal is { } foto ? FormatoProductos.Foto(foto.Id) : null)"
                                data-buscar="@FormatoProductos.ClavesBusqueda(p)">@FormatoProductos.Opcion(p)</option>
                    }
                </select>
            </div>
            <div class="field producto-selector-cantidad">
                <label class="sr-only" for="usado-cantidad">Unidades utilizadas</label>
                <input class="input num" type="number" id="usado-cantidad" min="1" max="@LineaProductoVisita.CantidadMaxima" step="1" value="1" inputmode="numeric" data-usado-cantidad />
            </div>
            <button type="button" class="btn btn-gray producto-selector-boton" data-usado-anadir><icono nombre="mas" tamano="17" /> Añadir</button>
        </div>
        <p class="field-hint" data-usado-aviso aria-live="polite" hidden></p>

        <div class="list producto-lineas" data-usados-lista hidden="@(usados.Count == 0)">
            @for (var i = 0; i < usados.Count; i++)
            {
                var p = Model.ParaVenta.FirstOrDefault(x => x.Id == usados[i].ProductoId);
                <div class="row producto-linea producto-usado" data-usado-linea data-producto-id="@usados[i].ProductoId" data-stock="@(p is null ? 0 : Model.Disponibles(p.Id))">
                    <span class="producto-miniatura producto-miniatura-sm">
                        <icono nombre="producto" tamano="18" />
                        @if (p?.FotoPrincipal is { } foto)
                        {
                            <img src="@FormatoProductos.Foto(foto.Id)" alt="" width="40" height="40" data-ocultar-si-falla />
                        }
                    </span>
                    <span class="row-main">
                        <span class="row-title" data-linea-nombre>@(p?.Nombre ?? "Producto que ya no está en el inventario")</span>
                        <span class="row-sub"><span class="producto-ref" data-linea-referencia>@p?.Referencia</span> · <span data-linea-stock>@(p is null ? "" : FormatoProductos.Disponible(Model.Disponibles(p.Id)))</span></span>
                    </span>
                    <input type="hidden" name="Usados[@i].ProductoId" value="@usados[i].ProductoId" data-linea-id />
                    <span class="producto-linea-cantidad">
                        <input class="input num" type="number" name="Usados[@i].Cantidad" min="1" max="@LineaProductoVisita.CantidadMaxima" step="1" value="@usados[i].Cantidad"
                               inputmode="numeric" aria-label="Unidades utilizadas de @(p?.Nombre ?? "este producto")" data-linea-cantidad />
                        <span>uds</span>
                    </span>
                    <button type="button" class="btn btn-gray btn-icono" aria-label="Quitar @(p?.Nombre ?? "este producto")" data-linea-quitar><icono nombre="cerrar" tamano="16" /></button>
                </div>
            }
        </div>

        <template data-usado-plantilla>
            <div class="row producto-linea producto-usado" data-usado-linea data-producto-id="" data-stock="0">
                <span class="producto-miniatura producto-miniatura-sm"><icono nombre="producto" tamano="18" /></span>
                <span class="row-main">
                    <span class="row-title" data-linea-nombre></span>
                    <span class="row-sub"><span class="producto-ref" data-linea-referencia></span> · <span data-linea-stock></span></span>
                </span>
                <input type="hidden" name="Usados[0].ProductoId" value="" data-linea-id />
                <span class="producto-linea-cantidad">
                    <input class="input num" type="number" name="Usados[0].Cantidad" min="1" max="@LineaProductoVisita.CantidadMaxima" step="1" value="1" inputmode="numeric" data-linea-cantidad />
                    <span>uds</span>
                </span>
                <button type="button" class="btn btn-gray btn-icono" data-linea-quitar><icono nombre="cerrar" tamano="16" /></button>
            </div>
        </template>
    }
    @Html.ValidationMessage("Usados")
</fieldset>
