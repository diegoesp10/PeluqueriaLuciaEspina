@model TratamientoEdicion
@{ ViewData["Title"] = "Publicar un servicio"; var f = Model.Formulario; }
<div class="form-pagina"><a class="back-link" asp-action="Index">← Servicios de la web</a><header class="page-head"><div><h1>Del catálogo a la web.</h1><p class="subtitle">Elige un servicio existente. Su nombre y precio se gestionan en una única ficha.</p></div></header>
<form class="form" method="post" asp-action="Nuevo"><div asp-validation-summary="All"></div><div class="fields">
<div class="field"><label for="ServicioId">Servicio del catálogo</label><select class="input" id="ServicioId" name="ServicioId" required><option value="">Selecciona un servicio</option>@foreach(var s in Model.Servicios.Where(s=>!s.Publicado)) { <option value="@s.Id" selected="@(s.Id == f.ServicioId)">@s.Nombre · @(s.Precio > 0 ? Formato.Euros(s.Precio) : "Precio por definir")</option> }</select><p class="field-hint"><a asp-controller="Catalogo" asp-action="Nuevo">Crear un servicio nuevo en el catálogo →</a></p></div>
<div class="field"><label for="CategoriaId">Categoría</label><select class="input" id="CategoriaId" name="CategoriaId" required>@foreach(var c in Model.Categorias) { <option value="@c.Id" selected="@(c.Id == f.CategoriaId)">@c.Nombre</option> }</select></div>
<div class="field"><label for="Descripcion">Descripción</label><textarea class="input" id="Descripcion" name="Descripcion" maxlength="1000" rows="3">@f.Descripcion</textarea></div>
<div class="field"><label for="DescripcionEn">Descripción en inglés</label><textarea class="input" id="DescripcionEn" name="DescripcionEn" maxlength="1000" rows="3" lang="en">@f.DescripcionEn</textarea><p class="field-hint">Si se deja vacía, la web en inglés muestra la descripción en español. El nombre en inglés del servicio se edita en el catálogo.</p></div>
<div class="field"><label for="TipoPrecio">Cómo se muestra el precio</label><select class="input" id="TipoPrecio" name="TipoPrecio"><option value="Fijo" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Fijo)">Precio fijo del catálogo</option><option value="Desde" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Desde)">Desde el precio del catálogo</option><option value="Consultar" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Consultar)">Consultar</option></select></div>
<div class="field"><label for="DuracionMinutos">Duración en minutos</label><input class="input" type="number" id="DuracionMinutos" name="DuracionMinutos" min="5" max="600" value="@f.DuracionMinutos" required /><p class="field-hint">El servicio aparecerá el último de su categoría; puedes moverlo con las flechas en «Servicios de la web».</p></div>
<label class="check-opcion"><input type="checkbox" name="Publicado" value="true" checked="@f.Publicado" /> Visible en la web</label><label class="check-opcion"><input type="checkbox" name="Destacado" value="true" checked="@f.Destacado" /> Destacado</label>
</div><div class="acciones acciones-form"><button class="btn btn-primary" type="submit">Publicar servicio</button><a class="btn btn-gray" asp-action="Index">Cancelar</a></div></form></div>
