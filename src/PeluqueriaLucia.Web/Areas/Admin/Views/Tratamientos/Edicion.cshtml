@model TratamientoEdicion
@{ ViewData["Title"] = Model.Id is null ? "Nuevo tratamiento" : "Editar tratamiento"; var f = Model.Formulario; }
<div class="form-pagina"><a class="back-link" asp-action="Index">← Servicios de la web</a><header class="page-head"><div><h1>@ViewData["Title"]</h1><p class="subtitle">Un cuidado que tus clientes encontrarán en la web.</p></div></header>
<form class="form" method="post" asp-action="@(Model.Id is null ? "Nuevo" : "Editar")" asp-route-id="@Model.Id"><div asp-validation-summary="All"></div><div class="fields">
<div class="field"><label for="Nombre">Nombre</label><input class="input" name="Nombre" id="Nombre" value="@f.Nombre" required maxlength="100" /></div>
<div class="field"><label for="CategoriaId">Categoría</label><select class="input" id="CategoriaId" name="CategoriaId" required>@foreach(var c in Model.Categorias) { <option value="@c.Id" selected="@(c.Id == f.CategoriaId)">@c.Nombre</option> }</select></div>
<div class="field"><label for="Descripcion">Descripción</label><textarea class="input" id="Descripcion" name="Descripcion" maxlength="1000" rows="3">@f.Descripcion</textarea></div>
<div class="fields-2"><div class="field"><label for="TipoPrecio">Cómo se muestra el precio</label><select class="input" id="TipoPrecio" name="TipoPrecio"><option value="Fijo" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Fijo)">Precio fijo</option><option value="Desde" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Desde)">Desde</option><option value="Consultar" selected="@(f.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Consultar)">Consultar</option></select></div><div class="field"><label for="Precio">Precio en euros</label><input class="input" id="Precio" name="Precio" inputmode="decimal" value="@Formato.Importe(f.Precio)" /><p class="field-hint">Para «Consultar», el precio no se publica.</p></div></div>
<div class="fields-2"><div class="field"><label for="DuracionMinutos">Duración en minutos</label><input class="input" type="number" id="DuracionMinutos" name="DuracionMinutos" min="5" max="600" value="@f.DuracionMinutos" required /></div><div class="field"><label for="Orden">Orden</label><input class="input" type="number" id="Orden" name="Orden" min="0" max="10000" value="@f.Orden" /></div></div>
<label class="check-opcion"><input type="checkbox" name="Publicado" value="true" checked="@f.Publicado" /> Visible en la web</label><label class="check-opcion"><input type="checkbox" name="Destacado" value="true" checked="@f.Destacado" /> Destacado</label>
</div><div class="acciones acciones-form"><button class="btn btn-primary" type="submit">Guardar tratamiento</button><a class="btn btn-gray" asp-action="Index">Cancelar</a></div></form>
@if(Model.Id is not null) { <form method="post" asp-action="Eliminar" asp-route-id="@Model.Id" class="section" data-confirmar="Se eliminará este tratamiento de la web. Las visitas y sus precios históricos se conservan."><button class="btn btn-gray" type="submit">Eliminar de la web</button></form> }
</div>
