@model TratamientosIndice
@{ ViewData["Title"] = "Servicios de la web"; }
<header class="page-head"><div><h1>Lo que ofreces.</h1><p class="subtitle">Precios y tratamientos de la página pública. Cada cambio se guarda en la base de datos.</p></div><div class="acciones"><a class="btn btn-gray" asp-action="Categorias">Categorías</a><a class="btn btn-primary" asp-action="Nuevo">Nuevo tratamiento</a></div></header>
<p class="section"><a class="enlace-flecha" asp-area="" asp-controller="Inicio" asp-action="Servicios" target="_blank">Ver cómo queda en la web ↗</a></p>
@foreach(var categoria in Model.Categorias) { <section class="section"><div class="section-head"><h2>@categoria.Nombre</h2></div><div class="list">@foreach(var t in Model.Tratamientos.Where(x => x.CategoriaId == categoria.Id)) { <div class="row"><div class="row-body"><strong>@t.Nombre</strong><p class="muted small">@(t.Publicado ? "Publicado" : "Oculto") · @t.DuracionMinutos min · @(t.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Consultar ? "Consultar" : (t.TipoPrecio == PeluqueriaLucia.Domain.Publico.TipoPrecioPublico.Desde ? "Desde " : "") + Formato.Euros(t.Precio!.Value))</p></div><a class="btn btn-gray btn-sm" asp-action="Editar" asp-route-id="@t.Id">Editar</a></div> }</div></section> }
