@model CategoriaEdicion
@{ ViewData["Title"] = Model.Id is null ? "Nueva categoría" : "Editar categoría"; }
<div class="form-pagina"><a class="back-link" asp-action="Categorias">← Categorías</a><header class="page-head"><h1>@ViewData["Title"]</h1></header><form class="form" method="post" asp-action="Categoria" asp-route-id="@Model.Id"><div asp-validation-summary="All"></div><div class="fields"><div class="field"><label for="Nombre">Nombre</label><input class="input" name="Nombre" id="Nombre" value="@Model.Formulario.Nombre" required maxlength="80" /></div><div class="field"><label for="Orden">Orden</label><input class="input" name="Orden" id="Orden" type="number" min="0" max="10000" value="@Model.Formulario.Orden" /></div></div><button class="btn btn-primary" type="submit">Guardar categoría</button></form>@if(Model.Id is not null) { <form class="section" method="post" asp-action="EliminarCategoria" asp-route-id="@Model.Id" data-confirmar="Se eliminará esta categoría si no contiene tratamientos."><button class="btn btn-gray">Eliminar categoría</button></form> }</div>
