@model AccesoFormulario
@{ Layout = "~/Views/Shared/_LayoutPublico.cshtml"; ViewData["Title"] = "Acceso profesional"; ViewData["ControlSesion"] = true; }
<section class="acceso-publico" aria-labelledby="titulo-acceso">
    <div class="acceso-panel">
        <header class="acceso-intro">
            <img src="~/Img/Icono.jpg" alt="Lucía Peluquería Ecológica" width="72" height="72" />
            <p class="etiqueta">TU ESPACIO PROFESIONAL</p>
            <h1 id="titulo-acceso">Tu salón,<br /><em>en tus manos.</em></h1>
            <p>Bienvenida de nuevo. Un momento para cuidar de tu salón.</p>
        </header>
        <form class="form-acceso" method="post" asp-area="Admin" asp-controller="Acceso" asp-action="Index">
            @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" role="alert"></div> }
            <input type="hidden" asp-for="Volver" />
            <div class="field"><label asp-for="Usuario">Usuario</label><input class="input" asp-for="Usuario" autocomplete="username" required maxlength="50" autofocus /></div>
            <div class="field"><label asp-for="Contrasena">Contraseña</label><input class="input" asp-for="Contrasena" type="password" autocomplete="current-password" required maxlength="256" /></div>
            <button class="btn btn-primary" type="submit">Entrar al panel <icono nombre="flecha" tamano="14" /></button>
            <p class="nota">Acceso exclusivo para la administración del salón.</p>
        </form>
        <a class="acceso-volver" asp-area="" asp-controller="Inicio" asp-action="Index"><icono nombre="volver" tamano="16" /> Volver al salón</a>
    </div>
</section>
